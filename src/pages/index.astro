---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Certifications from '../components/Certifications.astro';
import TeachingMentorship from '../components/TeachingMentorship.astro';
import CurrentlyLearning from '../components/CurrentlyLearning.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <!-- Floating Mode Switch Button -->
  <button id="mode-switch-btn" class="mode-switch-btn" aria-hidden="true">
    <span id="mode-switch-text"></span>
  </button>
  <!-- Main Graphical Site -->
  <div id="mode-graphical" class="mode-container" aria-hidden="true">
    <section class="hero">
      <div class="hero-content">
        <p class="hero-command" aria-label="[belal@portfolio ~]$ whoami">
          <span class="hero-prompt">[belal@portfolio ~]$</span> <span data-hero-command></span><span class="hero-command-cursor" aria-hidden="true">_</span>
        </p>
        <h1 class="hero-name" aria-label="Belal Alshref"><span data-hero-name-copy></span><span class="hero-name-tail" data-hero-name-tail><span class="hero-name-cursor" aria-hidden="true">_</span></span></h1>
        <p class="hero-label">// SOC Analyst & Cybersecurity</p>
        <p class="hero-tagline">All I want is to become undeniable.</p>
      </div>
    </section>
    
    <About />
    <Projects />
    <Experience />
    <TeachingMentorship />
    <Certifications />
    <CurrentlyLearning />
    <Footer />
  </div>

  <!-- Terminal Mode Island -->
  <div id="mode-terminal" class="mode-container" aria-hidden="true">
    <div class="terminal-island">
      <div class="terminal-header">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="title">belal@portfolio ~</span>
      </div>
      <div class="terminal-body">
        <p class="term-line"><span class="prompt">[belal@portfolio ~]$</span> ls -l</p>
        <p class="term-line output">
          <span class="dir">drwxr-xr-x</span> 2 belal root 4096 <span class="dir-name">projects</span><br/>
          <span class="dir">drwxr-xr-x</span> 2 belal root 4096 <span class="dir-name">skills</span><br/>
          <span class="file">-rw-r--r--</span> 1 belal root 1024 <span class="file-name">about.txt</span><br/>
          <span class="file">-rw-r--r--</span> 1 belal root  512 <span class="file-name">contact.txt</span>
        </p>
        <p class="term-line"><span class="prompt">[belal@portfolio ~]$</span> <span class="cursor-block"></span></p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @font-face {
    font-family: 'ZT Nature';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/zt-nature.bold.otf') format('opentype');
  }

  .mode-switch-btn {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 100;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-structural);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    transition: opacity 300ms ease, border-color var(--transition-instant), color var(--transition-instant);
    opacity: 0;
    pointer-events: none;
  }

  .mode-switch-btn.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .mode-switch-btn.is-hidden-scroll {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .mode-switch-btn:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .mode-container {
    display: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .mode-container.is-visible {
    display: block;
    /* Small delay so opacity transition happens after display:block */
    animation: fadeIn 300ms forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  /* Graphical Hero */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
  }

  .hero-content {
    max-width: 1500px;
    text-align: left;
    width: 100%;
    z-index: 2; /* above mouse glow */
  }

  .hero-command {
    color: var(--text-muted);
    font-size: clamp(.78rem, 1.15vw, 1rem);
    margin: 0 0 1.25rem;
  }

  .hero-prompt, .hero-command-cursor {
    color: var(--accent);
    font-weight: 700;
  }

  .hero-command-cursor {
    animation: hero-cursor-blink .7s steps(1, end) infinite;
    display: inline-block;
    margin-left: .08em;
  }

  .hero-label {
    color: var(--text-muted-2);
    font-size: clamp(.8rem, 1.15vw, 1rem);
    letter-spacing: .12em;
    margin: 1.4rem 0 0;
    text-transform: uppercase;
  }

  .hero-name {
    font-family: "ZT Nature", var(--font-mono);
    font-size: clamp(4rem, 12vw, 11rem);
    font-variation-settings: 'wght' 800;
    font-weight: 800;
    letter-spacing: -.07em;
    line-height: .86;
    max-width: 100%;
    color: var(--text-primary);
    margin: 0;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 0 8px rgba(122,162,247,.28), 0 0 26px rgba(125,207,255,.16);
  }

  .hero-name-tail { white-space: nowrap; }

  .hero-name-cursor {
    animation: hero-cursor-blink .7s steps(1, end) infinite;
    color: var(--accent);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .72em;
    font-weight: 500;
    letter-spacing: 0;
    margin-left: .04em;
    vertical-align: .08em;
  }

  .hero-tagline {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    max-width: 700px;
    margin: .75rem 0 0;
    font-style: italic;
  }

  @keyframes hero-cursor-blink {
    50% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .hero { padding: 1.5rem; }
    .hero-name { font-size: clamp(3.4rem, 16vw, 6.25rem); letter-spacing: -.075em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-command-cursor, .hero-name-cursor { animation: none; }
  }

  /* Terminal Stub */
  #mode-terminal {
    min-height: 100vh;
    padding: 2rem;
    display: none; /* hidden by default */
  }

  #mode-terminal.is-visible {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .terminal-island {
    width: 100%;
    max-width: 800px;
    background-color: var(--bg-panel-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 2;
  }

  .terminal-header {
    background-color: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .terminal-header .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .terminal-header .title {
    margin-left: auto;
    margin-right: auto;
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
  }

  .terminal-body {
    padding: 1.5rem;
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--text-primary);
  }

  .prompt {
    color: var(--term-green);
    margin-right: 0.5rem;
    font-weight: bold;
  }

  .output {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .dir { color: var(--term-blue); }
  .file { color: var(--text-muted-2); }
  .dir-name { color: var(--term-blue); font-weight: bold; }
  .file-name { color: var(--text-primary); }

  .cursor-block {
    display: inline-block;
    width: 10px;
    height: 1.2em;
    background-color: var(--accent);
    vertical-align: middle;
  }
</style>

<script>
  const graphicalMode = document.getElementById('mode-graphical');
  const terminalMode = document.getElementById('mode-terminal');
  const modeSwitchBtn = document.getElementById('mode-switch-btn');
  const modeSwitchText = document.getElementById('mode-switch-text');
  const heroCommand = document.querySelector('[data-hero-command]');
  const heroNameCopy = document.querySelector('[data-hero-name-copy]');
  const heroNameTail = document.querySelector('[data-hero-name-tail]');
  const heroNameCursor = document.querySelector('.hero-name-cursor');

  let currentMode = '';
  let heroCommandTyped = false;
  let heroNameTyped = false;

  const typeHeroName = () => {
    if (!(heroNameCopy instanceof HTMLElement) || !(heroNameTail instanceof HTMLElement) || !(heroNameCursor instanceof HTMLElement) || heroNameTyped) return;
    heroNameTyped = true;

    const name = 'Belal Alshref';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroNameCopy.textContent = name;
      heroNameTail.replaceChildren();
      return;
    }

    let index = 0;
    const typeNext = () => {
      const visibleText = name.slice(0, index++);
      heroNameCopy.textContent = visibleText.slice(0, -1);
      heroNameTail.replaceChildren(visibleText.slice(-1), heroNameCursor);
      if (index <= name.length) window.setTimeout(typeNext, 72);
    };
    typeNext();
  };

  const typeHeroCommand = () => {
    if (!(heroCommand instanceof HTMLElement) || heroCommandTyped) return;
    heroCommandTyped = true;

    const command = 'whoami';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroCommand.textContent = command;
      typeHeroName();
      return;
    }

    let index = 0;
    const typeNext = () => {
      heroCommand.textContent = command.slice(0, index++);
      if (index <= command.length) window.setTimeout(typeNext, 70);
      else window.setTimeout(typeHeroName, 220);
    };
    typeNext();
  };

  // Listen for mode selection from ModeGate
  document.addEventListener('mode-selected', (e) => {
    // @ts-ignore
    const mode = e.detail.mode;
    currentMode = mode;
    
    if (modeSwitchBtn && modeSwitchText) {
      modeSwitchBtn.classList.add('is-visible');
      modeSwitchBtn.removeAttribute('aria-hidden');
      modeSwitchText.textContent = mode === 'terminal' 
        ? '[<] Graphical Mode' 
        : '[<] Terminal Mode';
      
      // Reset scroll hidden state on mode switch
      modeSwitchBtn.classList.remove('is-hidden-scroll');
    }
    
    if (mode === 'terminal') {
      if (graphicalMode) {
        graphicalMode.classList.remove('is-visible');
        graphicalMode.setAttribute('aria-hidden', 'true');
      }
      if (terminalMode) {
        terminalMode.classList.add('is-visible');
        terminalMode.removeAttribute('aria-hidden');
      }
    } else {
      if (terminalMode) {
        terminalMode.classList.remove('is-visible');
        terminalMode.setAttribute('aria-hidden', 'true');
      }
      if (graphicalMode) {
        graphicalMode.classList.add('is-visible');
        graphicalMode.removeAttribute('aria-hidden');
      }
      window.setTimeout(typeHeroCommand, 180);
    }
  });

  // Handle mode switch button click
  if (modeSwitchBtn) {
    modeSwitchBtn.addEventListener('click', () => {
      const newMode = currentMode === 'terminal' ? 'graphical' : 'terminal';
      sessionStorage.setItem('portfolio-mode', newMode);
      document.dispatchEvent(new CustomEvent('mode-selected', { detail: { mode: newMode } }));
      
      // Scroll to top when switching
      window.scrollTo(0, 0);
    });
  }

  // Handle scroll to hide button in graphical mode
  window.addEventListener('scroll', () => {
    if (!modeSwitchBtn || currentMode !== 'graphical') return;
    
    if (window.scrollY > 100) {
      modeSwitchBtn.classList.add('is-hidden-scroll');
    } else {
      modeSwitchBtn.classList.remove('is-hidden-scroll');
    }
  }, { passive: true });

  // Check on initial load if we already bypassed the gate
  const savedMode = sessionStorage.getItem('portfolio-mode');
  if (savedMode) {
    document.dispatchEvent(new CustomEvent('mode-selected', { detail: { mode: savedMode } }));
  }
</script>
