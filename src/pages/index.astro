---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Certifications from '../components/Certifications.astro';
import TeachingMentorship from '../components/TeachingMentorship.astro';
import CurrentlyLearning from '../components/CurrentlyLearning.astro';
import Footer from '../components/Footer.astro';
import PersonalCorner from '../components/PersonalCorner.astro';
import TerminalMode from '../components/TerminalMode.astro';
---

<BaseLayout>
  <!-- Floating Mode Switch Button -->
  <button id="mode-switch-btn" class="mode-switch-btn" aria-hidden="true">
    <span id="mode-switch-text"></span>
  </button>
  <!-- Main Graphical Site -->
  <div id="mode-graphical" class="mode-container" aria-hidden="true">
    <section class="hero">
      <div class="hero-content">
        <p class="hero-command" aria-label="[belal@portfolio ~]$ whoami">
          <span class="hero-prompt">[belal@portfolio ~]$</span> <span data-hero-command></span><span class="hero-command-cursor" aria-hidden="true">_</span>
        </p>
        <h1 class="hero-name" aria-label="Belal Alshref"><span data-hero-name-copy></span><span class="hero-name-tail" data-hero-name-tail><span class="hero-name-cursor" aria-hidden="true">_</span></span></h1>
        <p class="hero-label">// SOC Analyst & Cybersecurity</p>
        <p class="hero-tagline">All I want is to become undeniable.</p>
      </div>
    </section>
    
    <About />
    <Projects />
    <Experience />
    <TeachingMentorship />
    <Certifications />
    <CurrentlyLearning />
    <Footer />
  </div>
  <!-- Terminal Mode Island -->
   <TerminalMode />
  <div id="personal-mode" aria-hidden="true" hidden>
    <PersonalCorner />
  </div>

  <div id="personal-confirmation" class="personal-door" aria-hidden="true" hidden>
    <section class="personal-confirmation-page" aria-labelledby="personal-confirmation-title">
      <div class="personal-confirmation-bar"><span class="personal-confirmation-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>belal@portfolio: ~/lancer</span><span class="personal-confirmation-status-code">[private]</span></div>
      <div class="personal-confirmation-content">
        <p class="personal-confirmation-command"><span>belal@portfolio:~$</span> cd .config/belal_XD</p>
        <p class="personal-confirmation-path">access request: <strong>personal-space</strong></p>
        <h1 id="personal-confirmation-title">off the record<span class="personal-confirmation-cursor">_</span></h1>
        <p class="personal-confirmation-copy">A small, personal corner outside the professional portfolio.</p>
        <p class="personal-confirmation-copy personal-confirmation-note">interests, unfinished thoughts, and things that do not belong on a résumé.</p>
      <form class="personal-confirmation-form" data-personal-confirm-form>
        <label for="personal-confirmation-input"><span>belal@portfolio:~$</span> type <code>I know</code> to continue</label>
        <div class="personal-confirmation-row"><span class="personal-confirmation-prompt" aria-hidden="true">&gt;</span><input id="personal-confirmation-input" data-personal-confirm-input autocomplete="off" spellcheck="false" placeholder="I know" /><button type="submit" data-personal-confirm-submit disabled>enter <span>↵</span></button></div>
        <p class="personal-confirmation-status" data-personal-confirm-status aria-live="polite">waiting for acknowledgement</p>
      </form>
      <button type="button" class="personal-confirmation-cancel" data-personal-confirm-cancel>← stay in the portfolio</button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @font-face {
    font-family: 'ZT Nature';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/zt-nature.bold.otf') format('opentype');
  }

  .mode-switch-btn {
    position: fixed;
    top: 2rem;
    left: 2rem;
    z-index: 100;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-structural);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    transition: opacity 300ms ease, border-color var(--transition-instant), color var(--transition-instant);
    opacity: 0;
    pointer-events: none;
  }

  .mode-switch-btn.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .mode-switch-btn.is-hidden-scroll {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .mode-switch-btn:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .mode-container {
    display: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .mode-container.is-visible {
    display: block;
    /* Small delay so opacity transition happens after display:block */
    animation: fadeIn 300ms forwards;
  }

  #personal-mode {
    background: var(--bg-base);
    clip-path: circle(0 at 0 100%);
    inset: 0;
    opacity: 0;
    overflow: auto;
    pointer-events: none;
    position: fixed;
    transition: clip-path 440ms cubic-bezier(.2,.8,.2,1), opacity 180ms ease;
    z-index: calc(var(--z-overlay) + 1);
  }

  #personal-mode[hidden] { display: none; }
  #personal-mode.is-active {
    clip-path: circle(150vmax at 0 100%);
    opacity: 1;
    pointer-events: auto;
  }

  #mode-graphical.personal-mode-leaving,
  #mode-terminal.personal-mode-leaving {
    opacity: 0;
    transform: scale(.985);
    transition: opacity 260ms ease, transform 260ms ease;
  }

  :global(body.personal-mode-active) { overflow: hidden; }

  .personal-door {
    background: var(--bg-base);
    clip-path: circle(0 at 0 100%);
    inset: 0;
    opacity: 0;
    overflow: auto;
    pointer-events: none;
    position: fixed;
    transition: clip-path 440ms cubic-bezier(.2,.8,.2,1), opacity 180ms ease;
    z-index: calc(var(--z-overlay) + 1);
  }

  .personal-door[hidden] { display: none; }
  .personal-door.is-active {
    clip-path: circle(150vmax at 0 100%);
    opacity: 1;
    pointer-events: auto;
  }

  .personal-confirmation-page {
    background: var(--bg-panel-solid);
    border: 1px solid var(--border-strong);
    box-shadow: 0 24px 80px rgba(0,0,0,.45), 0 0 0 1px rgba(125,207,255,.04);
    margin: clamp(1rem, 10vh, 7rem) auto;
    max-width: 760px;
    min-height: 0;
    padding: 0;
    width: calc(100% - 2rem);
  }
  .personal-confirmation-bar { align-items:center; background:var(--bg-panel); border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:10px; gap:.7rem; padding:.7rem 1rem; }
  .personal-confirmation-dots { display:flex; gap:.3rem; }.personal-confirmation-dots i { background:var(--border-strong); border-radius:50%; height:7px; width:7px; }.personal-confirmation-status-code { color:var(--accent); margin-left:auto; }
  .personal-confirmation-content { padding: clamp(1.25rem, 5vw, 3rem); }
  .personal-confirmation-command { color:var(--text-muted); font-size:11px; margin:0 0 1.8rem; }.personal-confirmation-command span,.personal-confirmation-form label span { color:var(--term-green); }
  .personal-confirmation-path { color:var(--accent); font-size:10px; }.personal-confirmation-path strong { color:var(--text-primary); font-weight:400; }
  .personal-confirmation-page h1 { color:var(--text-primary); font-size:clamp(2.3rem, 8vw, 5rem); letter-spacing:-.07em; line-height:.95; margin:.7rem 0 1rem; }.personal-confirmation-cursor { animation:secret-cursor .8s steps(1,end) infinite; color:var(--accent); font-size:.7em; }
  .personal-confirmation-copy { color:var(--text-muted); font-size:12px; line-height:1.8; margin:0; }.personal-confirmation-note { color:var(--text-muted-2); }
  .personal-confirmation-form { display:grid; gap:.75rem; margin-top:2.5rem; max-width:520px; }.personal-confirmation-form label { color:var(--text-muted); font-size:11px; }
  .personal-confirmation-form code { color: var(--accent); font-family: inherit; }
  .personal-confirmation-row { display:flex; }.personal-confirmation-prompt { align-items:center; background:var(--bg-base); border:1px solid var(--border); border-right:0; color:var(--accent); display:flex; padding:0 .75rem; }.personal-confirmation-row input { background:var(--bg-base); border:1px solid var(--border); border-right:0; color:var(--text-primary); font:inherit; font-size:12px; min-width:0; outline:none; padding:.75rem; width:100%; }
  .personal-confirmation-row input:focus { border-color: var(--accent); }
  .personal-confirmation-row button { background: var(--accent); border: 1px solid var(--accent); color: var(--bg-base); cursor: pointer; font: inherit; font-size: 11px; padding: .75rem 1rem; }
  .personal-confirmation-row button:disabled { background: var(--border); border-color: var(--border); color: var(--text-muted-2); cursor: not-allowed; }
  .personal-confirmation-row button:not(:disabled):hover,.personal-confirmation-row button:not(:disabled):focus-visible { background: var(--text-primary); outline: 1px solid var(--accent); outline-offset: 2px; }
  .personal-confirmation-status { color: var(--text-muted-2); font-size: 10px; }
  .personal-confirmation-status.is-ready { color: var(--term-green); }
  .personal-confirmation-cancel { background:transparent; border:0; color:var(--text-muted-2); cursor:pointer; font:inherit; font-size:11px; margin-top:2rem; padding:0; }
  .personal-confirmation-cancel:hover,.personal-confirmation-cancel:focus-visible { color: var(--text-primary); outline: 1px solid var(--accent); outline-offset: 3px; }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  /* Graphical Hero */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
  }

  .hero-content {
    max-width: 1500px;
    text-align: left;
    width: 100%;
    z-index: 2; /* above mouse glow */
  }

  .hero-command {
    color: var(--text-muted);
    font-size: clamp(.78rem, 1.15vw, 1rem);
    margin: 0 0 1.25rem;
  }

  .hero-prompt, .hero-command-cursor {
    color: var(--accent);
    font-weight: 700;
  }

  .hero-command-cursor {
    animation: hero-cursor-blink .7s steps(1, end) infinite;
    display: inline-block;
    margin-left: .08em;
  }

  .hero-label {
    color: var(--text-muted-2);
    font-size: clamp(.8rem, 1.15vw, 1rem);
    letter-spacing: .12em;
    margin: 1.4rem 0 0;
    text-transform: uppercase;
  }

  .hero-name {
    font-family: "ZT Nature", var(--font-mono);
    font-size: clamp(4rem, 12vw, 11rem);
    font-variation-settings: 'wght' 800;
    font-weight: 800;
    letter-spacing: -.07em;
    line-height: .86;
    max-width: 100%;
    color: var(--text-primary);
    margin: 0;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 0 8px rgba(122,162,247,.28), 0 0 26px rgba(125,207,255,.16);
  }

  .hero-name-tail { white-space: nowrap; }

  .hero-name-cursor {
    animation: hero-cursor-blink .7s steps(1, end) infinite;
    color: var(--accent);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .72em;
    font-weight: 500;
    letter-spacing: 0;
    margin-left: .04em;
    vertical-align: .08em;
  }

  .hero-tagline {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    max-width: 700px;
    margin: .75rem 0 0;
    font-style: italic;
  }

  @keyframes hero-cursor-blink {
    50% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .hero { padding: 1.5rem; }
    .hero-name { font-size: clamp(3.4rem, 16vw, 6.25rem); letter-spacing: -.075em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-command-cursor, .hero-name-cursor { animation: none; }
    #personal-mode { transition: none; }
    .personal-door { transition: none; }
    #mode-graphical.personal-mode-leaving, #mode-terminal.personal-mode-leaving { transition: none; transform: none; }
  }

  /* Terminal Stub */
  #mode-terminal {
    min-height: 100vh;
    padding: 2rem;
    display: none; /* hidden by default */
  }

  #mode-terminal.is-visible {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .terminal-island {
    width: 100%;
    max-width: 800px;
    background-color: var(--bg-panel-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 2;
  }

  .terminal-header {
    background-color: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .terminal-header .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .terminal-header .title {
    margin-left: auto;
    margin-right: auto;
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
  }

  .terminal-body {
    padding: 1.5rem;
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--text-primary);
  }

  .prompt {
    color: var(--term-green);
    margin-right: 0.5rem;
    font-weight: bold;
  }

  .output {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .dir { color: var(--term-blue); }
  .file { color: var(--text-muted-2); }
  .dir-name { color: var(--term-blue); font-weight: bold; }
  .file-name { color: var(--text-primary); }

  .cursor-block {
    display: inline-block;
    width: 10px;
    height: 1.2em;
    background-color: var(--accent);
    vertical-align: middle;
  }
</style>

<script>
  const graphicalMode = document.getElementById('mode-graphical');
  const terminalMode = document.getElementById('mode-terminal');
  const modeSwitchBtn = document.getElementById('mode-switch-btn');
  const modeSwitchText = document.getElementById('mode-switch-text');
  const heroCommand = document.querySelector('[data-hero-command]');
  const heroNameCopy = document.querySelector('[data-hero-name-copy]');
  const heroNameTail = document.querySelector('[data-hero-name-tail]');
  const heroNameCursor = document.querySelector('.hero-name-cursor');
  const personalMode = document.getElementById('personal-mode');
  const personalConfirmation = document.getElementById('personal-confirmation');
  const personalConfirmationForm = document.querySelector('[data-personal-confirm-form]') as HTMLFormElement | null;
  const personalConfirmationInput = document.querySelector('[data-personal-confirm-input]') as HTMLInputElement | null;
  const personalConfirmationSubmit = document.querySelector('[data-personal-confirm-submit]') as HTMLButtonElement | null;
  const personalConfirmationStatus = document.querySelector('[data-personal-confirm-status]') as HTMLElement | null;
  const personalConfirmationCancel = document.querySelector('[data-personal-confirm-cancel]') as HTMLButtonElement | null;
  const personalAudio = document.querySelector('[data-personal-audio]') as HTMLIFrameElement | null;
  const personalBackButtons = [...document.querySelectorAll('[data-personal-back]')] as HTMLElement[];
  const personalReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const personalTransitionDuration = personalReducedMotion ? 0 : 460;
  const portfolioViews = [graphicalMode, terminalMode].filter((view): view is HTMLElement => view instanceof HTMLElement);

  let currentMode = '';
  let heroCommandTyped = false;
  let heroNameTyped = false;
  let personalModeOpen = false;
  let personalConfirmationOpen = false;
  let personalModeTimer: number | undefined;
  let personalModeFocus: HTMLElement | null = null;

  const hidePortfolioForPersonalMode = () => {
    document.body.classList.add('personal-mode-active');
    portfolioViews.forEach((view) => {
      view.classList.add('personal-mode-leaving');
      view.setAttribute('aria-hidden', 'true');
    });
    modeSwitchBtn?.setAttribute('aria-hidden', 'true');
  };

  const restorePortfolioAfterPersonalMode = () => {
    document.body.classList.remove('personal-mode-active');
    portfolioViews.forEach((view) => {
      view.classList.remove('personal-mode-leaving');
      view.setAttribute('aria-hidden', view === graphicalMode && currentMode === 'graphical' ? 'false' : 'true');
    });
    if (modeSwitchBtn?.classList.contains('is-visible')) modeSwitchBtn.removeAttribute('aria-hidden');
  };

  const closePersonalConfirmation = () => {
    if (!personalConfirmation || !personalConfirmationOpen) return;
    personalConfirmationOpen = false;
    personalConfirmation.classList.remove('is-active');
    personalConfirmation.setAttribute('aria-hidden', 'true');
    restorePortfolioAfterPersonalMode();
    window.setTimeout(() => { personalConfirmation.hidden = true; }, personalTransitionDuration);
    window.setTimeout(() => personalModeFocus?.focus(), personalTransitionDuration);
  };

  const openPersonalConfirmation = () => {
    if (!personalConfirmation || personalConfirmationOpen || personalModeOpen) return;
    personalConfirmationOpen = true;
    personalModeFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (personalConfirmationInput) personalConfirmationInput.value = '';
    if (personalConfirmationSubmit) personalConfirmationSubmit.disabled = true;
    personalConfirmationStatus?.classList.remove('is-ready');
    if (personalConfirmationStatus) personalConfirmationStatus.textContent = 'waiting for acknowledgement';
    personalConfirmation.hidden = false;
    personalConfirmation.setAttribute('aria-hidden', 'false');
    hidePortfolioForPersonalMode();
    window.requestAnimationFrame(() => {
      personalConfirmation.classList.add('is-active');
      window.setTimeout(() => personalConfirmationInput?.focus(), personalTransitionDuration);
    });
  };

  const enterPersonalMode = () => {
    if (!personalMode || personalModeOpen) return;
    personalModeOpen = true;
    window.clearTimeout(personalModeTimer);
    if (personalConfirmation) {
      personalConfirmation.classList.remove('is-active');
      personalConfirmation.setAttribute('aria-hidden', 'true');
      window.setTimeout(() => { personalConfirmation.hidden = true; }, personalReducedMotion ? 0 : 180);
    }
    personalMode.hidden = false;
    personalMode.setAttribute('aria-hidden', 'false');
    hidePortfolioForPersonalMode();
    if (personalAudio && !personalAudio.dataset.started) {
      personalAudio.src = personalAudio.dataset.src || '';
      personalAudio.dataset.started = 'true';
    }

    window.requestAnimationFrame(() => {
      personalMode.classList.add('is-active');
      window.setTimeout(() => document.querySelector<HTMLElement>('[data-personal-back]')?.focus(), personalTransitionDuration);
    });
  };

  const leavePersonalMode = () => {
    if (!personalMode || !personalModeOpen) return;
    personalModeOpen = false;
    personalMode.classList.remove('is-active');
    if (personalAudio) personalAudio.src = '';
    restorePortfolioAfterPersonalMode();
    personalMode.setAttribute('aria-hidden', 'true');
    personalModeTimer = window.setTimeout(() => { personalMode.hidden = true; }, personalTransitionDuration);
    window.setTimeout(() => personalModeFocus?.focus(), personalTransitionDuration);
  };

  document.addEventListener('personal-space-enter', openPersonalConfirmation);
  personalBackButtons.forEach((button) => button.addEventListener('click', leavePersonalMode));
  personalConfirmationCancel?.addEventListener('click', closePersonalConfirmation);
  personalConfirmationInput?.addEventListener('input', () => {
    const ready = personalConfirmationInput.value.trim().toLowerCase() === 'i know';
    if (personalConfirmationSubmit) personalConfirmationSubmit.disabled = !ready;
    personalConfirmationStatus?.classList.toggle('is-ready', ready);
    if (personalConfirmationStatus) personalConfirmationStatus.textContent = ready ? 'acknowledgement received — access unlocked' : 'waiting for acknowledgement';
  });
  personalConfirmationForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!personalConfirmationSubmit?.disabled) enterPersonalMode();
  });
  document.addEventListener('keydown', (event) => {
    if (personalModeOpen && event.key === 'Escape') {
      event.preventDefault();
      leavePersonalMode();
    } else if (personalConfirmationOpen && event.key === 'Escape') {
      event.preventDefault();
      closePersonalConfirmation();
    }
  });

  const typeHeroName = () => {
    if (!(heroNameCopy instanceof HTMLElement) || !(heroNameTail instanceof HTMLElement) || !(heroNameCursor instanceof HTMLElement) || heroNameTyped) return;
    heroNameTyped = true;

    const name = 'Belal Alshref';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroNameCopy.textContent = name;
      heroNameTail.replaceChildren();
      return;
    }

    let index = 0;
    const typeNext = () => {
      const visibleText = name.slice(0, index++);
      heroNameCopy.textContent = visibleText.slice(0, -1);
      heroNameTail.replaceChildren(visibleText.slice(-1), heroNameCursor);
      if (index <= name.length) window.setTimeout(typeNext, 72);
    };
    typeNext();
  };

  const typeHeroCommand = () => {
    if (!(heroCommand instanceof HTMLElement) || heroCommandTyped) return;
    heroCommandTyped = true;

    const command = 'whoami';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroCommand.textContent = command;
      typeHeroName();
      return;
    }

    let index = 0;
    const typeNext = () => {
      heroCommand.textContent = command.slice(0, index++);
      if (index <= command.length) window.setTimeout(typeNext, 70);
      else window.setTimeout(typeHeroName, 220);
    };
    typeNext();
  };

  // Listen for mode selection from ModeGate
  document.addEventListener('mode-selected', (e) => {
    // @ts-ignore
    const mode = e.detail.mode;
    currentMode = mode;
    
    if (modeSwitchBtn && modeSwitchText) {
      modeSwitchBtn.classList.add('is-visible');
      modeSwitchBtn.removeAttribute('aria-hidden');
      modeSwitchText.textContent = mode === 'terminal' 
        ? '[<] Graphical Mode' 
        : '[<] Terminal Mode';
      
      // Reset scroll hidden state on mode switch
      modeSwitchBtn.classList.remove('is-hidden-scroll');
    }
    
    if (mode === 'terminal') {
      if (graphicalMode) {
        graphicalMode.classList.remove('is-visible');
        graphicalMode.setAttribute('aria-hidden', 'true');
      }
      if (terminalMode) {
        terminalMode.classList.add('is-visible');
        terminalMode.removeAttribute('aria-hidden');
      }
    } else {
      if (terminalMode) {
        terminalMode.classList.remove('is-visible');
        terminalMode.setAttribute('aria-hidden', 'true');
      }
      if (graphicalMode) {
        graphicalMode.classList.add('is-visible');
        graphicalMode.removeAttribute('aria-hidden');
      }
      window.setTimeout(typeHeroCommand, 180);
    }
  });

  // Handle mode switch button click
  if (modeSwitchBtn) {
    modeSwitchBtn.addEventListener('click', () => {
      const newMode = currentMode === 'terminal' ? 'graphical' : 'terminal';
      sessionStorage.setItem('portfolio-mode', newMode);
      document.dispatchEvent(new CustomEvent('mode-selected', { detail: { mode: newMode } }));
      
      // Scroll to top when switching
      window.scrollTo(0, 0);
    });
  }

  // Handle scroll to hide button in graphical mode
  window.addEventListener('scroll', () => {
    if (!modeSwitchBtn || currentMode !== 'graphical') return;
    
    if (window.scrollY > 100) {
      modeSwitchBtn.classList.add('is-hidden-scroll');
    } else {
      modeSwitchBtn.classList.remove('is-hidden-scroll');
    }
  }, { passive: true });

  // Check on initial load if we already bypassed the gate
  const savedMode = sessionStorage.getItem('portfolio-mode');
  if (savedMode) {
    document.dispatchEvent(new CustomEvent('mode-selected', { detail: { mode: savedMode } }));
  }
</script>
