---
import { mentorship } from '../data/mentorship.js';
---

<section id="teaching" class="teaching-section">
  <div class="teaching-heading">
    <span class="terminal-prompt">[belal@portfolio ~]$</span><h2 class="heading-text">ls mentorship</h2>
  </div>

  <div class="teaching-container">
    <article class="mentorship-record">
      <header class="mentorship-header">
        <div><span>{mentorship.location} · {mentorship.period}</span><h3>{mentorship.role} <i>at</i> {mentorship.org}</h3></div>
        <span class="mentorship-status"><i></i>ACTIVE</span>
      </header>

      <div class="mentorship-metrics" aria-label="OSC-MUST mentorship metrics">
        {mentorship.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>

      <div class="syllabus">
        <div class="syllabus-heading"><span>~/</span><h4>topics --list</h4></div>
        <ol>
          {mentorship.topics.map((topic, index) => <li><code>{String(index + 1).padStart(2, '0')}</code><span>{topic}</span></li>)}
        </ol>
      </div>

      <div class="mentorship-footer">
        <blockquote>“{mentorship.philosophy}”</blockquote>
        <div><a href="#about">[ see ~/about-me ]</a><span>[ workshop materials, URL pending ]</span></div>
      </div>
    </article>
  </div>
</section>

<style>
  .teaching-section { align-items:center; background:var(--bg-base); display:flex; flex-direction:column; gap:2rem; padding:6rem 2rem 8rem; }.teaching-heading { align-items:baseline; border-bottom:1px solid var(--border); display:flex; gap:.7rem; max-width:1320px; padding-bottom:1.75rem; width:100%; }.terminal-prompt { color:var(--accent); font-family:var(--font-mono); font-size:clamp(.85rem,1.5vw,1.15rem); font-weight:700; white-space:nowrap; }.heading-text { color:var(--text-primary); font-family:var(--font-mono); font-size:clamp(1.65rem,3.4vw,3rem); font-weight:700; margin:0; }
  .teaching-container { max-width:1320px; width:100%; }.mentorship-record { background:var(--bg-panel-solid); border:1px solid var(--border); padding:1.5rem; }.mentorship-header { align-items:flex-start; border-bottom:1px solid var(--border); display:flex; gap:1rem; justify-content:space-between; padding-bottom:1rem; }.mentorship-header > div > span { color:var(--text-muted-2); font-size:10px; letter-spacing:.04em; }.mentorship-header h3 { color:var(--text-primary); font-size:clamp(1.05rem,1.8vw,1.45rem); line-height:1.45; margin:.35rem 0 0; }.mentorship-header h3 i { color:var(--accent); font-style:normal; font-weight:400; }.mentorship-status { align-items:center; color:var(--term-green); display:flex; font-size:10px; gap:.45rem; }.mentorship-status i { animation:status-pulse 1.6s ease-in-out infinite; background:var(--term-green); border-radius:50%; height:5px; width:5px; }
  .mentorship-metrics { border-bottom:1px solid var(--border); display:grid; grid-template-columns:repeat(3,1fr); margin:0 -1.5rem; }.mentorship-metrics div { border-right:1px solid var(--border); padding:1rem 1.5rem; }.mentorship-metrics div:last-child { border-right:0; }.mentorship-metrics strong { color:var(--text-primary); display:block; font-size:clamp(1.2rem,2vw,1.75rem); }.mentorship-metrics span { color:var(--text-muted-2); display:block; font-size:10px; line-height:1.5; margin-top:.35rem; max-width:240px; }
  .syllabus { margin-top:1.5rem; }.syllabus-heading { align-items:baseline; display:flex; gap:0; }.syllabus-heading span { color:var(--accent); font-size:var(--font-size-lg); font-weight:700; }.syllabus-heading h4 { color:var(--text-primary); font-size:var(--font-size-lg); margin:0; }.syllabus ol { border:1px solid var(--border); list-style:none; margin:1rem 0 0; padding:0; }.syllabus li { align-items:flex-start; border-bottom:1px solid var(--border); color:var(--text-muted); display:grid; font-size:var(--font-size-sm); gap:1rem; grid-template-columns:36px minmax(0,1fr); line-height:1.65; padding:.75rem 1rem; }.syllabus li:last-child { border-bottom:0; }.syllabus code { color:var(--accent); font-family:inherit; font-size:10px; padding-top:.2rem; }
  .mentorship-footer { align-items:flex-end; border-top:1px solid var(--border); display:flex; flex-wrap:wrap; gap:1rem; justify-content:space-between; margin-top:1.5rem; padding-top:1rem; }.mentorship-footer blockquote { border-left:2px solid var(--accent); color:var(--text-muted); font-size:var(--font-size-sm); line-height:1.7; margin:0; max-width:700px; padding-left:.75rem; }.mentorship-footer > div { display:flex; flex-direction:column; gap:.45rem; }.mentorship-footer a, .mentorship-footer > div span { font-size:10px; white-space:nowrap; }.mentorship-footer a { color:var(--accent); text-decoration:none; }.mentorship-footer a:hover, .mentorship-footer a:focus-visible { color:var(--text-primary); outline:none; }.mentorship-footer > div span { color:var(--text-muted-2); }
  @keyframes status-pulse { 50% { box-shadow:0 0 0 4px rgba(158,206,106,0); opacity:.45; } }
  @media (max-width:640px) { .teaching-section { padding:5rem 1rem 6rem; }.teaching-heading { align-items:flex-start; flex-wrap:wrap; gap:.35rem .55rem; }.terminal-prompt { font-size:.78rem; padding-top:.35rem; }.heading-text { font-size:clamp(1.35rem,7vw,1.8rem); }.mentorship-record { padding:1rem; }.mentorship-header { flex-direction:column; }.mentorship-metrics { grid-template-columns:1fr; margin:0 -1rem; }.mentorship-metrics div { border-bottom:1px solid var(--border); border-right:0; padding:1rem; }.mentorship-metrics div:last-child { border-bottom:0; }.mentorship-footer { align-items:flex-start; flex-direction:column; } }
  @media (prefers-reduced-motion:reduce) { .mentorship-status i { animation:none; } }
</style>
