---
import ProjectFeaturedHeader from './ProjectFeaturedHeader.astro';
const { project } = Astro.props;
---

<article class="featured-project contest-platform reveal" data-slug={project.slug}>
  <ProjectFeaturedHeader project={project} />

  <section class="system-hero" aria-labelledby="system-title">
    <div class="system-intro">
      <div>
        <h4 id="system-title">Codeforces, scheduled and scored — inside Discord.</h4>
        <p>Members connect their Codeforces accounts, practice problems, challenge each other, and join timed contests — while the bot handles scheduling, scoring, leaderboards, and solve verification.</p>
        <p class="contribution-line">{project.contribution}</p>
      </div>
      <button class="quiet-action" type="button" data-architecture-run>Run request <span>→</span></button>
    </div>
    <div class="sway-layout" aria-label="Discord user, bot, cogs, Codeforces API, SQLite, configuration, bot logic, and Discord response architecture">
      <div class="component-grid">
        <button type="button" class="sway-pane is-focused" data-pane="0"><span><i>@</i> Discord User</span><small>/contest join</small><em class="tile-connector edge-right" data-edge="0" aria-hidden="true">→</em></button>
        <button type="button" class="sway-pane" data-pane="1"><span><i>#</i> MUST CPC Bot</span><small>async Python cogs</small><em class="tile-connector edge-right" data-edge="1" aria-hidden="true">→</em></button>
        <button type="button" class="sway-pane" data-pane="2"><span><i>*</i> Feature / Cog</span><small>contests · challenges</small><em class="tile-connector edge-down" data-edge="2" aria-hidden="true">↓</em></button>
        <button type="button" class="sway-pane" data-pane="3"><span><i>:</i> Configuration</span><small>roles · channels</small><em class="tile-connector edge-left" data-edge="3" aria-hidden="true">←</em></button>
        <button type="button" class="sway-pane" data-pane="4"><span><i>=</i> SQLite Database</span><small>contests · scores</small><em class="tile-connector edge-left" data-edge="4" aria-hidden="true">←</em></button>
        <button type="button" class="sway-pane" data-pane="5"><span><i>~</i> Codeforces API</span><small>problems · submissions</small><em class="tile-connector edge-down" data-edge="5" aria-hidden="true">↓</em></button>
      </div>
      <div class="outcome-grid">
        <button type="button" class="sway-pane" data-pane="6"><span><i>&gt;</i> Bot Logic</span><small>verify · score · rank</small><em class="tile-connector edge-right" data-edge="6" aria-hidden="true">→</em></button>
        <button type="button" class="sway-pane" data-pane="7"><span><i>&lt;</i> Discord Response</span><small>contest · leaderboard</small></button>
      </div>
    </div>
    <div class="route-trace" aria-label="Request progress" data-route-trace>
      <span class="is-active" data-trace="0"><i>@</i>Discord</span><b>→</b><span data-trace="1"><i>#</i>Bot</span><b>→</b><span data-trace="2"><i>*</i>Cog</span><b>→</b><span data-trace="3"><i>:</i>Config</span><b>→</b><span data-trace="4"><i>=</i>SQLite</span><b>→</b><span data-trace="5"><i>~</i>Codeforces</span><b>→</b><span data-trace="6"><i>&gt;</i>Logic</span><b>→</b><span data-trace="7"><i>&lt;</i>Response</span>
    </div>
    <div class="architecture-inspector" aria-live="polite"><span data-architecture-step>01 / 08</span><b data-architecture-status>Discord User</b><small data-architecture-check>checking command payload</small><small data-architecture-detail>/contest join → command received</small></div>
  </section>

  <div class="metrics-strip" aria-label="Project metrics">
    {project.metrics.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
  </div>

  <div class="interaction-grid">
    <section class="lifecycle-panel" aria-labelledby="lifecycle-title">
      <div class="panel-heading"><h4 id="lifecycle-title">Contest lifecycle</h4><span class="plain-meta">scheduler: 1 min</span></div>
      <p class="panel-copy">Stored timestamps and contest state drive the transition — the scheduler advances eligible contests without a manual sequence.</p>
      <div class="waybar-strip" data-contest-machine aria-label="Contest state machine">
        <button type="button" class="is-current" data-state="0"><i></i><span>PENDING</span><small>Scheduled</small></button>
        <button type="button" data-state="1"><i></i><span>ACTIVE</span><small>Participants solving</small></button>
        <button type="button" data-state="2"><i></i><span>ENDED</span><small>Leaderboard</small></button>
      </div>
      <div class="lifecycle-detail" data-lifecycle-detail>Waiting to start</div>
      <button type="button" class="quiet-action lifecycle-action" data-advance-state>Advance timeline <span>→</span></button>
    </section>
    <section class="verification-panel" aria-labelledby="verify-title">
      <div class="panel-heading"><h4 id="verify-title">Verify, don’t trust.</h4><span class="plain-meta">Codeforces = source of truth</span></div>
      <p class="panel-copy">A “Check Solved” action queries submission history; a score changes only when an accepted result is found.</p>
      <div class="foot-terminal" data-verification-terminal aria-live="polite">
        <div class="terminal-titlebar"><span></span><span></span><span></span><b>foot — cf verification</b></div>
        <pre data-terminal-output>$ cf check belal PROBLEM_A</pre><span class="block-cursor" aria-hidden="true"></span>
      </div>
      <button type="button" class="quiet-action verify-action" data-check-solved>Check Solved <span>→</span></button>
    </section>
  </div>

  <section class="builder-panel" aria-labelledby="builder-title">
    <div class="panel-heading"><h4 id="builder-title">Contest builder</h4><span class="plain-meta">discord.py modal + view</span></div>
    <p class="panel-copy">Mentors configure a contest through Discord-native modals, buttons, and views — then review the stored plan before it is created.</p>
    <button type="button" class="quiet-action launcher-action" data-builder-open>Open contest builder <span>↵</span></button>
    <div class="wofi-overlay" data-builder-overlay aria-hidden="true">
      <div class="wofi-modal" role="dialog" aria-modal="true" aria-label="Contest builder">
        <div class="wofi-input"><span>&gt; contest builder</span><button type="button" data-builder-close aria-label="Close contest builder">×</button></div>
        <div class="builder-progress" aria-label="Contest creation progress"><span class="is-current" data-progress="0">01 Name</span><span data-progress="1">02 Problems</span><span data-progress="2">03 Duration</span><span data-progress="3">04 Review</span></div>
        <form class="contest-form" data-contest-form>
          <section class="builder-step is-active" data-builder-step="0"><label>Contest name<input data-contest-name maxlength="48" value="Weekly practice #12" autocomplete="off" /></label><label>Start time<select data-contest-start><option value="30 minutes">In 30 minutes</option><option value="1 hour">In 1 hour</option><option value="tomorrow">Tomorrow</option></select></label></section>
          <section class="builder-step" data-builder-step="1"><span class="field-label">Choose up to 3 problems</span><div class="problem-options"><label><input type="checkbox" data-problem value="Two Sum" checked />Two Sum <small>800</small></label><label><input type="checkbox" data-problem value="Graph Paths" checked />Graph Paths <small>1200</small></label><label><input type="checkbox" data-problem value="Dynamic Array" checked />Dynamic Array <small>1500</small></label><label><input type="checkbox" data-problem value="Tree Queries" />Tree Queries <small>1800</small></label></div></section>
          <section class="builder-step" data-builder-step="2"><label>Contest duration <output data-duration-output>120 minutes</output><input type="range" min="30" max="240" step="30" value="120" data-contest-duration /></label><div class="duration-scale"><span>30m</span><span>4h</span></div></section>
          <section class="builder-step" data-builder-step="3"><span class="field-label">Ready to publish</span><dl class="contest-review"><div><dt>Name</dt><dd data-review-name></dd></div><div><dt>Problems</dt><dd data-review-problems></dd></div><div><dt>Schedule</dt><dd data-review-schedule></dd></div><div><dt>Duration</dt><dd data-review-duration></dd></div></dl></section>
          <div class="builder-actions"><button type="button" class="quiet-action" data-builder-back>← Back</button><button type="button" class="quiet-action builder-next" data-builder-next>Continue →</button></div>
        </form>
        <div class="builder-success" data-builder-success hidden><b>✓ Contest created</b><p data-created-summary></p><button type="button" class="quiet-action" data-builder-reset>Create another</button></div>
      </div>
    </div>
  </section>

  <section class="score-panel" aria-labelledby="score-title">
    <div><h4 id="score-title">A leaderboard backed by rules.</h4><p>Problem value is derived from rating; the first accepted solve earns a small bonus.</p></div>
    <div class="score-widget" data-score-widget>
      <label>Problem rating <output data-rating-output>1500</output><input type="range" min="800" max="3500" step="100" value="1500" data-rating /></label>
      <label class="first-solve"><input type="checkbox" checked data-first-solve /> First to solve</label>
      <div class="score-result"><small>POINTS</small><strong><span data-base-points>15</span><i data-bonus> + 3</i> = <em data-total-points>18</em></strong></div>
    </div>
  </section>

  <details class="technical-dive" data-technical-dive>
    <summary><span class="dive-path">~/</span><strong>technical-deep-dive</strong><small>// data flow &amp; storage boundaries</small></summary>
    <div class="dive-content">
      <div class="api-flow"><b>Discord User</b><span>→</span><b>Bot logic</b><span>→</span><b>Codeforces API</b><span>→</span><b>Discord response</b><p><code>user.info</code> account linking &nbsp; <code>problemset.problems</code> selection &nbsp; <code>contest.status</code> solve checks</p></div>
      <div class="database-layers"><div><span>db.db</span><b>Competitive data</b><p>Users · contests · challenges · participants · scores</p></div><div><span>roles_and_channels.db</span><b>Per-guild configuration</b><p>Roles · channels · guild configuration</p></div></div>
    </div>
  </details>
</article>

<style>
  .featured-project { background:var(--bg-panel-solid); border:1px solid var(--border); border-radius:var(--radius-structural); padding:2.5rem; width:100%; }
  .system-hero,.lifecycle-panel,.verification-panel,.builder-panel,.score-panel { background:var(--bg-base); border:1px solid var(--border); border-radius:0; padding:1.25rem; }.system-intro { display:flex; align-items:start; justify-content:space-between; gap:1.5rem; margin-bottom:1.5rem; }.system-intro h4,.panel-heading h4,.score-panel h4 { color:var(--text-primary); font-size:var(--font-size-xl); margin:0; }.system-intro p,.panel-copy,.score-panel p { color:var(--text-muted); font-size:var(--font-size-sm); line-height:1.65; margin:.55rem 0 0; max-width:760px; }.system-intro .contribution-line { color:var(--text-muted-2); font-size:11px; }
  .quiet-action { background:transparent; border:1px solid var(--border); border-radius:0; color:var(--text-muted); cursor:pointer; font:inherit; font-size:11px; padding:.5rem .65rem; white-space:nowrap; }.quiet-action:hover,.quiet-action:focus-visible { border-color:var(--accent); color:var(--text-primary); outline:none; }.quiet-action span { color:var(--accent); }
  .sway-layout { border:1px solid var(--border); }.component-grid { display:grid; grid-template-columns:repeat(3,1fr); }.component-grid [data-pane="3"] { border-right:0; grid-area:2 / 3; }.component-grid [data-pane="4"] { grid-area:2 / 2; }.component-grid [data-pane="5"] { border-right:1px solid var(--border); grid-area:2 / 1; }.outcome-grid { border-top:1px solid var(--border); display:grid; grid-template-columns:repeat(2,1fr); }.sway-pane { background:transparent; border:0; border-right:1px solid var(--border); border-bottom:1px solid var(--border); color:inherit; cursor:pointer; font:inherit; min-height:70px; padding:.75rem; display:grid; align-content:center; gap:.25rem; position:relative; text-align:left; transition:border-color 100ms linear,background-color 100ms linear; }.component-grid .sway-pane:nth-child(3n) { border-right:0; }.component-grid .sway-pane:nth-child(n+4) { border-bottom:0; }.outcome-grid .sway-pane { border-bottom:0; }.outcome-grid .sway-pane:last-child { border-right:0; }.sway-pane:hover,.sway-pane:focus-visible { background:rgba(122,162,247,.04); outline:0; }.sway-pane span { color:var(--text-primary); font-size:12px; font-weight:700; }.sway-pane span i { color:inherit; font-size:13px; font-style:normal; margin-right:.35rem; }.sway-pane small { color:var(--text-muted-2); font-size:10px; }.sway-pane.is-focused { background:rgba(122,162,247,.06); border-color:var(--accent); box-shadow:inset 0 0 0 1px var(--accent); z-index:2; }.tile-connector { align-items:center; background:var(--bg-base); color:var(--border-strong); display:flex; font-size:14px; font-style:normal; font-weight:400; height:20px; justify-content:center; position:absolute; width:20px; z-index:3; }.tile-connector.edge-right { right:-10px; top:calc(50% - 10px); }.tile-connector.edge-left { left:-10px; top:calc(50% - 10px); }.tile-connector.edge-down { bottom:-10px; left:calc(50% - 10px); }.tile-connector.is-active { color:var(--accent); }.route-trace { border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.75rem; padding:0 0 .65rem; }.route-trace span { align-items:center; display:flex; font-size:10px; gap:.3rem; }.route-trace span i { color:inherit; font-size:11px; font-style:normal; }.route-trace b { color:var(--border-strong); font-size:11px; font-weight:400; }.route-trace span.is-active { color:var(--accent); }.route-trace span.is-complete { color:var(--text-muted); }.route-trace span.is-complete i { color:var(--accent); }.architecture-inspector { border-left:2px solid var(--accent); display:grid; gap:.15rem; margin-top:.75rem; padding-left:.65rem; }.architecture-inspector span { color:var(--text-muted-2); font-size:10px; }.architecture-inspector b { color:var(--text-primary); font-size:12px; }.architecture-inspector small { color:var(--text-muted-2); font-size:10px; }.architecture-inspector small[data-architecture-check] { color:var(--accent); }
  .metrics-strip { display:grid; grid-template-columns:repeat(5,1fr); border-top:1px solid var(--border); border-bottom:1px solid var(--border); margin:1.25rem 0; }.metrics-strip div { border-right:1px solid var(--border); padding:.75rem 1rem; }.metrics-strip div:last-child { border-right:0; }.metrics-strip strong { color:var(--text-primary); display:block; font-size:18px; }.metrics-strip span { color:var(--text-muted-2); display:block; font-size:10px; line-height:1.35; margin-top:.25rem; }
  .interaction-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; align-items:start; }.panel-heading { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; }.panel-heading h4,.score-panel h4 { font-size:var(--font-size-lg); }.plain-meta { color:var(--text-muted-2); font-size:10px; white-space:nowrap; }
  .waybar-strip { border:1px solid var(--border); display:grid; grid-template-columns:repeat(3,1fr); margin-top:1.25rem; }.waybar-strip button { background:transparent; border:0; border-right:1px solid var(--border); color:var(--text-muted-2); cursor:pointer; display:flex; align-items:center; gap:.45rem; justify-content:center; padding:.7rem .35rem; font:inherit; min-width:0; }.waybar-strip button:last-child { border-right:0; }.waybar-strip button i { background:var(--border-strong); border-radius:50%; height:6px; width:6px; }.waybar-strip button span { font-size:11px; }.waybar-strip button small { display:none; }.waybar-strip button.is-current { background:var(--accent); color:var(--bg-base); }.waybar-strip button.is-current i { background:var(--bg-base); }.waybar-strip button:focus-visible { outline:1px solid var(--text-primary); outline-offset:-3px; }.lifecycle-detail { color:var(--text-muted-2); font-size:11px; min-height:1.6em; margin-top:.65rem; }.lifecycle-action { margin-top:.85rem; }
  .foot-terminal { background:var(--bg-panel-solid); border:1px solid var(--border); min-height:126px; margin-top:1.25rem; padding:0 .85rem .85rem; }.terminal-titlebar { border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; align-items:center; gap:5px; margin:0 -.85rem .75rem; padding:.45rem .65rem; font-size:10px; }.terminal-titlebar span { background:var(--border-strong); height:6px; width:6px; }.terminal-titlebar b { font-weight:400; margin-left:.4rem; }.foot-terminal pre { color:var(--text-primary); font:inherit; font-size:11px; line-height:1.8; margin:0; min-height:58px; white-space:pre-wrap; }.block-cursor { background:var(--accent); display:inline-block; height:1.05em; vertical-align:-.18em; width:.55em; }.foot-terminal.is-typing .block-cursor { animation:cursor-blink 1s steps(2,end) infinite; }.wofi-input .block-cursor { animation:none; }.verify-action { margin-top:.85rem; }.verification-panel.is-verified .foot-terminal { border-color:var(--term-green); }.verification-panel.is-verified .foot-terminal pre { color:var(--term-green); } @keyframes cursor-blink { 50% { opacity:0; } }
  .builder-panel { margin-top:1.25rem; }.launcher-action { margin-top:1rem; }.wofi-overlay { background:rgba(10,10,10,.82); display:grid; inset:0; opacity:0; padding:1rem; place-items:center; pointer-events:none; position:fixed; transition:opacity 100ms linear; z-index:var(--z-overlay); }.wofi-overlay.is-open { opacity:1; pointer-events:auto; }.wofi-modal { background:var(--bg-panel-solid); border:1px solid var(--border-strong); max-width:540px; opacity:0; transform:translateY(-4px); transition:opacity 100ms linear,transform 100ms linear; width:100%; }.wofi-overlay.is-open .wofi-modal { opacity:1; transform:none; }.wofi-input { border-bottom:1px solid var(--border); color:var(--text-primary); padding:.8rem 1rem; font-size:13px; }.wofi-list { padding:.4rem; }.wofi-list button { background:transparent; border:0; color:var(--text-muted); cursor:pointer; display:flex; font:inherit; font-size:12px; justify-content:space-between; padding:.65rem .75rem; text-align:left; width:100%; }.wofi-list button small { color:var(--text-muted-2); font-size:10px; }.wofi-list button.is-selected { background:var(--accent); color:var(--bg-base); }.wofi-list button.is-selected small { color:var(--bg-base); }.wofi-list button.is-complete::before { color:var(--accent); content:'✓'; margin-right:.5rem; }.wofi-list button:focus-visible { outline:1px solid var(--text-primary); outline-offset:-2px; }.wofi-run { border-top:1px solid var(--border); color:var(--text-muted-2); display:none; font:inherit; font-size:10px; line-height:1.8; margin:0; padding:.65rem 1rem; white-space:pre-wrap; }.wofi-run.is-running { display:block; }.wofi-run.is-complete { color:var(--term-green); }.wofi-hint { border-top:1px solid var(--border); color:var(--text-muted-2); font-size:10px; padding:.6rem 1rem; }
  .score-panel { align-items:center; display:flex; gap:2rem; justify-content:space-between; margin-top:1.25rem; }.score-widget { display:grid; grid-template-columns:1fr auto; gap:.75rem 1.25rem; min-width:330px; }.score-widget label { color:var(--text-muted-2); font-size:11px; }.score-widget output { color:var(--text-primary); float:right; }.score-widget input[type="range"] { accent-color:var(--accent); display:block; margin-top:.45rem; width:100%; }.first-solve { align-items:center; display:flex; gap:.45rem; white-space:nowrap; }.first-solve input { accent-color:var(--accent); }.score-result { border-top:1px solid var(--border); display:flex; grid-column:1 / -1; justify-content:space-between; padding-top:.7rem; }.score-result small { color:var(--text-muted-2); font-size:10px; }.score-result strong { color:var(--text-primary); font-size:16px; }.score-result i { color:var(--text-muted); font-style:normal; }.score-result em { color:var(--accent); font-style:normal; }
  .technical-dive { background:var(--bg-base); border-top:1px solid var(--border); border-bottom:1px solid var(--border); border-left:0; border-right:0; border-radius:0; margin-top:1.25rem; }.technical-dive summary { color:var(--text-primary); cursor:pointer; padding:.85rem 0; font-size:12px; }.technical-dive summary span { color:var(--accent); margin-right:.5rem; }.technical-dive summary small { color:var(--text-muted-2); margin-left:.5rem; }.dive-content { border-top:1px solid var(--border); display:grid; gap:1.5rem; grid-template-columns:1fr 1fr; padding:1rem 0; }.api-flow { align-items:center; color:var(--text-muted-2); display:flex; flex-wrap:wrap; font-size:11px; gap:.5rem; }.api-flow b { color:var(--text-primary); }.api-flow span { color:var(--accent); }.api-flow p { color:var(--text-muted-2); line-height:1.8; margin:.5rem 0 0; width:100%; }.api-flow code,.database-layers span { color:var(--accent); }.database-layers { border-left:1px solid var(--border); display:grid; gap:.7rem; padding-left:1rem; }.database-layers b { color:var(--text-primary); display:block; font-size:12px; margin-top:.1rem; }.database-layers p { color:var(--text-muted-2); font-size:11px; margin:.2rem 0; }
  .builder-progress { border-bottom:1px solid var(--border); display:grid; grid-template-columns:repeat(4,1fr); }.builder-progress span { color:var(--text-muted-2); font-size:10px; padding:.6rem .5rem; text-align:center; }.builder-progress .is-current { background:rgba(122,162,247,.12); color:var(--accent); }.contest-form { padding:1rem; }.builder-step { display:none; min-height:148px; }.builder-step.is-active { display:grid; gap:.9rem; }.builder-step label,.field-label { color:var(--text-muted); display:block; font-size:11px; }.builder-step input:not([type="checkbox"]),.builder-step select { background:var(--bg-base); border:1px solid var(--border); box-sizing:border-box; color:var(--text-primary); font:inherit; font-size:12px; margin-top:.45rem; padding:.65rem; width:100%; }.builder-step input:focus,.builder-step select:focus { border-color:var(--accent); outline:0; }.builder-step output { color:var(--accent); float:right; }.builder-step input[type="range"] { accent-color:var(--accent); padding:0; }.duration-scale { color:var(--text-muted-2); display:flex; font-size:10px; justify-content:space-between; margin-top:-.5rem; }.problem-options { border:1px solid var(--border); }.problem-options label { align-items:center; border-bottom:1px solid var(--border); cursor:pointer; display:flex; gap:.55rem; padding:.55rem .65rem; }.problem-options label:last-child { border-bottom:0; }.problem-options input { accent-color:var(--accent); }.problem-options small { color:var(--accent); margin-left:auto; }.builder-actions { border-top:1px solid var(--border); display:flex; justify-content:space-between; margin:1rem -1rem -1rem; padding: .75rem 1rem 0; }.builder-next { background:var(--accent); border-color:var(--accent); color:var(--bg-base); }.builder-success { padding:2rem 1rem; text-align:center; }.builder-success b { color:var(--term-green); display:block; font-size:14px; }.builder-success p { color:var(--text-muted); font-size:11px; line-height:1.6; margin: .65rem auto 1rem; max-width:360px; }.wofi-input { align-items:center; display:flex; justify-content:space-between; }.wofi-input button { background:transparent; border:0; color:var(--text-muted); cursor:pointer; font-size:18px; line-height:1; }.wofi-input button:hover { color:var(--text-primary); }.technical-dive { border:1px solid var(--border); padding:0 1.5rem; }.technical-dive summary { align-items:baseline; display:flex; gap:0; margin:0 -1.5rem; padding:1.15rem 1.5rem; }.technical-dive summary::marker { color:var(--accent); }.technical-dive .dive-path { color:var(--accent); font-size:clamp(1.3rem,2.4vw,2rem); font-weight:700; margin:0; }.technical-dive summary strong { color:var(--text-primary); font-size:clamp(1.3rem,2.4vw,2rem); font-weight:700; }.technical-dive summary small { color:var(--text-muted-2); font-size:11px; margin-left:1rem; }.dive-content { gap:2rem; margin:0 -1.5rem; padding:1.5rem; }.api-flow { font-size:13px; gap:.65rem; }.api-flow p { font-size:12px; line-height:2; margin-top:.85rem; }.database-layers { gap:1rem; padding-left:1.5rem; }.database-layers b { font-size:14px; }.database-layers p { font-size:12px; line-height:1.65; }
  @media (max-width:900px) { .interaction-grid { grid-template-columns:1fr; }.metrics-strip { grid-template-columns:repeat(3,1fr); }.metrics-strip div:nth-child(3) { border-right:0; }.metrics-strip div:nth-child(n+4) { border-top:1px solid var(--border); } }
  @media (max-width:600px) { .featured-project { padding:1rem; }.system-hero,.lifecycle-panel,.verification-panel,.builder-panel,.score-panel { padding:1rem; }.system-intro,.score-panel { align-items:start; flex-direction:column; }.component-grid,.outcome-grid { grid-template-columns:1fr; }.component-grid .sway-pane,.component-grid .sway-pane:nth-child(3n),.outcome-grid .sway-pane { border-right:0; border-bottom:1px solid var(--border); }.component-grid .sway-pane:nth-child(n+4) { border-bottom:1px solid var(--border); }.outcome-grid .sway-pane:last-child { border-bottom:0; }.tile-connector.edge-right,.tile-connector.edge-left { bottom:-10px; left:calc(50% - 10px); right:auto; top:auto; transform:rotate(90deg); }.tile-connector.edge-down { bottom:-10px; left:calc(50% - 10px); }.route-trace { display:grid; grid-template-columns:1fr; gap:.2rem; }.route-trace b { display:none; }.metrics-strip { grid-template-columns:repeat(2,1fr); }.metrics-strip div:nth-child(3) { border-right:1px solid var(--border); }.metrics-strip div:nth-child(even) { border-right:0; }.metrics-strip div:nth-child(n+3) { border-top:1px solid var(--border); }.metrics-strip div:last-child { grid-column:span 2; }.waybar-strip { grid-template-columns:1fr; }.waybar-strip button { border-bottom:1px solid var(--border); border-right:0; justify-content:start; padding:.65rem .75rem; }.waybar-strip button:last-child { border-bottom:0; }.waybar-strip button small { display:inline; margin-left:auto; }.score-widget { min-width:0; width:100%; }.dive-content { grid-template-columns:1fr; }.database-layers { border-left:0; border-top:1px solid var(--border); padding:1rem 0 0; } }
  @media (prefers-reduced-motion:reduce) { .block-cursor { animation:none; }.wofi-overlay,.wofi-modal { transition:none; } }
</style>

<script>
  const root = document.currentScript?.closest('article') || document.querySelector('[data-slug="must-cpc-discord-bot"]');
  if (root) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.querySelector('[data-technical-dive]')?.removeAttribute('open');
    const panes = [...root.querySelectorAll('[data-pane]')] as HTMLElement[];
    const paneInfo = [
      ['Discord User', 'checking command payload', '/contest join → command received'],
      ['MUST CPC Bot', 'checking interaction route', 'interaction routed through async command handling'],
      ['Feature / Cog', 'checking selected workflow', 'contest workflow selected'],
      ['Configuration', 'checking guild configuration', 'resolving roles and channels for this guild'],
      ['SQLite Database', 'checking contest state', 'reading contest and participant state'],
      ['Codeforces API', 'checking Codeforces data', 'requesting problem and submission data'],
      ['Bot Logic', 'checking scoring rules', 'verification, scoring, and ranking applied'],
      ['Discord Response', 'checking response payload', 'contest update and leaderboard delivered'],
    ]; let pane = 0; let requestRunning = false;
    const focusPane = (next: number) => { pane = next % panes.length; panes.forEach((item) => item.classList.toggle('is-focused', Number(item.dataset.pane) === pane)); root.querySelectorAll('[data-edge]').forEach((item) => item.classList.toggle('is-active', Number((item as HTMLElement).dataset.edge) < pane)); root.querySelectorAll('[data-trace]').forEach((item) => { const index = Number((item as HTMLElement).dataset.trace); item.classList.toggle('is-active', index === pane); item.classList.toggle('is-complete', index < pane); }); const title = root.querySelector('[data-architecture-status]'); const check = root.querySelector('[data-architecture-check]'); const detail = root.querySelector('[data-architecture-detail]'); const step = root.querySelector('[data-architecture-step]'); if (title) title.textContent = paneInfo[pane][0]; if (check) check.textContent = paneInfo[pane][1]; if (detail) detail.textContent = paneInfo[pane][2]; if (step) step.textContent = `${String(pane + 1).padStart(2, '0')} / 08`; };
    const routeOrder = [0, 1, 2, 3, 4, 5, 6, 7];
    const beginCursorWork = (button: HTMLButtonElement) => { button.setAttribute('aria-busy', 'true'); document.dispatchEvent(new CustomEvent('cursor-work-start')); };
    const endCursorWork = (button: HTMLButtonElement) => { button.removeAttribute('aria-busy'); document.dispatchEvent(new CustomEvent('cursor-work-end')); };
    panes.forEach((item) => item.addEventListener('click', () => focusPane(Number(item.dataset.pane))));
    root.querySelector('[data-architecture-run]')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; if (requestRunning) return; requestRunning = true; beginCursorWork(button); button.disabled = true; button.textContent = 'Routing…'; let next = 0; const route = () => { focusPane(routeOrder[next++]); if (next < routeOrder.length) window.setTimeout(route, reducedMotion ? 0 : 850); else { button.disabled = false; button.innerHTML = 'Run request <span>→</span>'; requestRunning = false; endCursorWork(button); } }; route(); });
    const details = ['Waiting to start', 'Problems posted · Check Solved available', 'Scores finalized · Leaderboard generated']; let state = 0;
    const setState = (next: number) => { state = next; root.querySelectorAll('[data-state]').forEach((item) => { const active = Number((item as HTMLElement).dataset.state) === state; item.classList.toggle('is-current', active); item.setAttribute('aria-pressed', String(active)); }); const detail = root.querySelector('[data-lifecycle-detail]'); if (detail) detail.textContent = details[state]; };
    root.querySelectorAll('[data-state]').forEach((item) => item.addEventListener('click', () => setState(Number((item as HTMLElement).dataset.state)))); root.querySelector('[data-advance-state]')?.addEventListener('click', () => setState((state + 1) % 3));
    root.querySelector('[data-check-solved]')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; const output = root.querySelector('[data-terminal-output]') as HTMLElement | null; const terminal = root.querySelector('[data-verification-terminal]'); if (!output || button.disabled) return; beginCursorWork(button); button.disabled = true; button.textContent = 'Checking…'; const text = '$ cf check belal PROBLEM_A\n> OK: accepted — verified on Codeforces\n> +13 points, leaderboard updated'; const reveal = () => { output.textContent = text; terminal?.parentElement?.classList.add('is-verified'); button.textContent = 'Verified'; endCursorWork(button); }; if (reducedMotion) { reveal(); return; } terminal?.classList.add('is-typing'); output.textContent = ''; let index = 0; const type = () => { output.textContent = text.slice(0, index++); if (index <= text.length) window.setTimeout(type, 12); else { terminal?.classList.remove('is-typing'); reveal(); } }; type(); });
    const overlay = root.querySelector('[data-builder-overlay]') as HTMLElement | null; const launcher = root.querySelector('[data-builder-open]') as HTMLButtonElement | null; const steps = [...root.querySelectorAll('[data-builder-step]')] as HTMLElement[]; const progress = [...root.querySelectorAll('[data-progress]')] as HTMLElement[]; const form = root.querySelector('[data-contest-form]') as HTMLFormElement | null; const success = root.querySelector('[data-builder-success]') as HTMLElement | null; const name = root.querySelector('[data-contest-name]') as HTMLInputElement | null; const start = root.querySelector('[data-contest-start]') as HTMLSelectElement | null; const duration = root.querySelector('[data-contest-duration]') as HTMLInputElement | null; const problems = [...root.querySelectorAll('[data-problem]')] as HTMLInputElement[]; let builderIndex = 0;
    const selectedProblems = () => problems.filter((problem) => problem.checked).map((problem) => problem.value);
    const updateReview = () => { const values: Record<string, string> = { '[data-review-name]': name?.value.trim() || 'Untitled contest', '[data-review-problems]': selectedProblems().join(' · ') || 'No problems selected', '[data-review-schedule]': start?.selectedOptions[0]?.text || 'Not scheduled', '[data-review-duration]': `${duration?.value || 120} minutes` }; Object.entries(values).forEach(([selector, value]) => { const item = root.querySelector(selector); if (item) item.textContent = value; }); const output = root.querySelector('[data-duration-output]'); if (output) output.textContent = `${duration?.value || 120} minutes`; };
    const selectBuilder = (next: number) => { builderIndex = Math.max(0, Math.min(next, steps.length - 1)); steps.forEach((step, index) => step.classList.toggle('is-active', index === builderIndex)); progress.forEach((item, index) => item.classList.toggle('is-current', index === builderIndex)); const back = root.querySelector('[data-builder-back]') as HTMLButtonElement | null; const nextButton = root.querySelector('[data-builder-next]') as HTMLButtonElement | null; if (back) back.disabled = builderIndex === 0; if (nextButton) nextButton.textContent = builderIndex === steps.length - 1 ? 'Create contest ✓' : 'Continue →'; updateReview(); };
    const closeBuilder = () => { overlay?.classList.remove('is-open'); overlay?.setAttribute('aria-hidden', 'true'); launcher?.focus(); };
    const resetBuilder = () => { form?.removeAttribute('hidden'); if (success) success.hidden = true; selectBuilder(0); name?.focus(); };
    const createContest = () => { form?.setAttribute('hidden', ''); if (success) { success.hidden = false; const summary = root.querySelector('[data-created-summary]'); if (summary) summary.textContent = `${name?.value.trim() || 'Untitled contest'} is scheduled ${start?.selectedOptions[0]?.text.toLowerCase()} with ${selectedProblems().length} problems.`; } };
    launcher?.addEventListener('click', () => { overlay?.classList.add('is-open'); overlay?.setAttribute('aria-hidden', 'false'); resetBuilder(); }); root.querySelector('[data-builder-close]')?.addEventListener('click', closeBuilder); root.querySelector('[data-builder-reset]')?.addEventListener('click', resetBuilder); root.querySelector('[data-builder-back]')?.addEventListener('click', () => selectBuilder(builderIndex - 1)); root.querySelector('[data-builder-next]')?.addEventListener('click', () => { if (builderIndex === 0 && !name?.value.trim()) { name?.focus(); return; } if (builderIndex === 1 && !selectedProblems().length) return; if (builderIndex === steps.length - 1) createContest(); else selectBuilder(builderIndex + 1); }); [name, start, duration].forEach((input) => input?.addEventListener('input', updateReview)); problems.forEach((problem) => problem.addEventListener('change', () => { if (selectedProblems().length > 3) problem.checked = false; updateReview(); })); overlay?.addEventListener('click', (event) => { if (event.target === overlay) closeBuilder(); }); document.addEventListener('keydown', (event) => { if (!overlay?.classList.contains('is-open')) return; if (event.key === 'Escape') closeBuilder(); }); updateReview();
    const rating = root.querySelector('[data-rating]') as HTMLInputElement | null; const firstSolve = root.querySelector('[data-first-solve]') as HTMLInputElement | null;
    const updateScore = () => { if (!rating || !firstSolve) return; const base = Math.max(10, Math.floor(Number(rating.value) / 100)); const bonus = firstSolve.checked ? 3 : 0; const set = (selector: string, value: string) => { const element = root.querySelector(selector); if (element) element.textContent = value; }; set('[data-rating-output]', rating.value); set('[data-base-points]', String(base)); set('[data-bonus]', bonus ? ' + 3' : ''); set('[data-total-points]', String(base + bonus)); };
    rating?.addEventListener('input', updateScore); firstSolve?.addEventListener('change', updateScore); updateScore();
  }
</script>
