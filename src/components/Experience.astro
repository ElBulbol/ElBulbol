---
import { experience } from '../data/experience.js';

const selectedId = 'depi';
---

<section id="experience" class="experience-section">
  <div class="experience-heading">
    <span class="terminal-prompt">[belal@portfolio ~]$</span><h2 class="heading-text">ls experience</h2>
  </div>

  <div class="experience-container">
    <p class="experience-intro">Learning the systems first.<br />Then learning how to defend them.</p>

    <div class="experience-records" aria-label="Experience records">
      {experience.map((item) => (
        <button
          class:list={['experience-record', { 'is-selected': item.id === selectedId }]}
          type="button"
          data-experience-select={item.id}
          aria-controls={`experience-${item.id}`}
          aria-expanded={item.id === selectedId ? 'true' : 'false'}
        >
          <div class="record-meta"><span>{item.period}</span>{item.status && <em>{item.status}</em>}</div>
          <strong>{item.organization}</strong>
          <small>{item.role}</small>
          <span class="open-record">Open record <b>→</b></span>
        </button>
      ))}
    </div>

    <div class="experience-details">
      {experience.map((item) => (
        <article id={`experience-${item.id}`} class:list={['experience-detail', { 'is-selected': item.id === selectedId }]} data-experience-detail={item.id} hidden={item.id !== selectedId}>
          <header class="detail-header">
            <div>
              <span class="detail-kicker">{item.location} · {item.dates}</span>
              <h3>{item.organization} <span>—</span> {item.role}</h3>
            </div>
            {item.status && <span class="active-status"><i></i>{item.status}</span>}
          </header>

          <p class="detail-summary">{item.summary}</p>

          {item.id === 'cib' ? (
            <div class="technical-flow horizontal-flow" aria-label="CIB enterprise IT workflow">
              <span class="flow-label">ENTERPRISE IT FLOW</span>
              <div class="flow-steps">
                {item.flow.map((step, index) => <><b>{step}</b>{index < item.flow.length - 1 && <i aria-hidden="true">→</i>}</>)}
              </div>
            </div>
          ) : (
            <div class="depi-detail">
              <div class="lab-count"><strong>{item.labs}</strong><span>HANDS-ON TRAINING</span></div>
              <div class="investigation-areas"><span>INVESTIGATION AREAS</span><div>{item.areas?.map((area) => <b>{area}</b>)}</div></div>
              <div class="technical-flow horizontal-flow" aria-label="DEPI incident response workflow">
                <span class="flow-label">INVESTIGATION FLOW</span>
                <div class="flow-steps">
                  {item.flow.map((step, index) => <><b>{step}</b>{index < item.flow.length - 1 && <i aria-hidden="true">→</i>}</>)}
                </div>
              </div>
            </div>
          )}

          <p class="detail-note">{item.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section { align-items:center; background:var(--bg-base); display:flex; flex-direction:column; gap:2rem; padding:6rem 2rem 8rem; }
  .experience-heading { align-items:baseline; border-bottom:1px solid var(--border); display:flex; gap:.7rem; max-width:1320px; padding-bottom:1.75rem; width:100%; }
  .terminal-prompt { color:var(--accent); font-family:var(--font-mono); font-size:clamp(.85rem,1.5vw,1.15rem); font-weight:700; white-space:nowrap; }
  .heading-text { color:var(--text-primary); font-family:var(--font-mono); font-size:clamp(1.65rem,3.4vw,3rem); font-weight:700; margin:0; }
  .experience-container { display:flex; flex-direction:column; gap:1.5rem; max-width:1320px; width:100%; }
  .experience-intro { color:var(--text-muted); font-size:clamp(1rem,1.35vw,1.2rem); line-height:1.8; margin:0; }
  .experience-records { display:grid; gap:1rem; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .experience-record { background:var(--bg-panel-solid); border:1px solid var(--border); color:var(--text-primary); cursor:pointer; display:flex; flex-direction:column; font-family:var(--font-mono); gap:.45rem; min-height:175px; padding:1.2rem; position:relative; text-align:left; transition:border-color var(--transition-instant), background-color var(--transition-instant); }
  .experience-record:hover, .experience-record:focus-visible { border-color:var(--border-strong); outline:none; }
  .experience-record.is-selected { background:rgba(122,162,247,.055); border-color:var(--accent); box-shadow:inset 2px 0 0 var(--accent); }
  .record-meta { align-items:center; color:var(--text-muted-2); display:flex; font-size:10px; justify-content:space-between; letter-spacing:.04em; }
  .record-meta em { color:var(--term-green); font-size:9px; font-style:normal; }
  .experience-record strong { font-size:var(--font-size-lg); margin-top:.4rem; }
  .experience-record small { color:var(--text-muted); font-size:11px; line-height:1.5; max-width:390px; }
  .open-record { color:var(--text-muted-2); font-size:11px; margin-top:auto; }
  .open-record b { color:var(--accent); font-size:14px; font-weight:400; margin-left:.25rem; }
  .experience-record.is-selected .open-record { color:var(--text-primary); }
  .experience-detail { background:var(--bg-panel-solid); border:1px solid var(--border); padding:1.5rem; }
  .experience-detail.is-selected { border-color:var(--border-strong); }
  .detail-header { align-items:flex-start; border-bottom:1px solid var(--border); display:flex; gap:1rem; justify-content:space-between; padding-bottom:1rem; }
  .detail-kicker, .flow-label, .investigation-areas > span, .lab-count span { color:var(--text-muted-2); display:block; font-size:10px; letter-spacing:.04em; }
  .detail-header h3 { color:var(--text-primary); font-size:clamp(1rem,1.7vw,1.35rem); line-height:1.45; margin:.35rem 0 0; }
  .detail-header h3 span { color:var(--accent); font-weight:400; }
  .active-status { align-items:center; border:1px solid rgba(158,206,106,.4); color:var(--term-green); display:flex; font-size:10px; gap:.45rem; padding:.35rem .5rem; white-space:nowrap; }
  .active-status i { background:var(--term-green); border-radius:50%; height:5px; width:5px; }
  .detail-summary, .detail-note { color:var(--text-muted); font-size:var(--font-size-sm); line-height:1.75; margin:1.25rem 0; max-width:900px; }
  .technical-flow { border:1px solid var(--border); padding:1rem; }
  .flow-steps { align-items:center; display:flex; gap:.55rem; margin-top:.75rem; }
  .flow-steps b { background:var(--bg-base); border:1px solid var(--border); color:var(--text-primary); font-size:11px; font-weight:500; padding:.45rem .55rem; text-align:center; }
  .flow-steps i { color:var(--accent); font-size:14px; font-style:normal; }
  .depi-detail { display:grid; gap:1rem; grid-template-columns:180px 1fr; }
  .lab-count, .investigation-areas { border:1px solid var(--border); padding:1rem; }
  .lab-count { display:flex; flex-direction:column; justify-content:center; }
  .lab-count strong { color:var(--text-primary); font-size:var(--font-size-lg); line-height:1.3; }
  .lab-count span { margin-top:.35rem; }
  .investigation-areas > div { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.75rem; }
  .investigation-areas b { border:1px solid var(--border); color:var(--text-muted); font-size:10px; font-weight:500; padding:.35rem .45rem; }
  .horizontal-flow { grid-column:1 / -1; }
  .detail-note { border-left:2px solid var(--accent); margin-bottom:0; padding-left:.75rem; }
  @media (max-width:640px) { .experience-section { padding:5rem 1rem 6rem; }.experience-heading { align-items:flex-start; flex-wrap:wrap; gap:.35rem .55rem; }.terminal-prompt { font-size:.78rem; padding-top:.35rem; }.heading-text { font-size:clamp(1.35rem,7vw,1.8rem); }.experience-records { grid-template-columns:1fr; }.detail-header { flex-direction:column; }.depi-detail { grid-template-columns:1fr; }.flow-steps { gap:.35rem; max-width:100%; overflow-x:auto; padding-bottom:.25rem; white-space:nowrap; } }
  @media (prefers-reduced-motion:reduce) { .experience-record { transition:none; } }
</style>

<script>
  const experienceSection = document.querySelector('#experience');
  if (experienceSection) {
    const records = [...experienceSection.querySelectorAll('[data-experience-select]')] as HTMLButtonElement[];
    const details = [...experienceSection.querySelectorAll('[data-experience-detail]')] as HTMLElement[];

    const selectExperience = (id: string) => {
      records.forEach((record) => {
        const selected = record.dataset.experienceSelect === id;
        record.classList.toggle('is-selected', selected);
        record.setAttribute('aria-expanded', String(selected));
      });
      details.forEach((detail) => {
        const selected = detail.dataset.experienceDetail === id;
        detail.classList.toggle('is-selected', selected);
        detail.hidden = !selected;
      });
    };

    records.forEach((record) => record.addEventListener('click', () => selectExperience(record.dataset.experienceSelect || 'depi')));
  }
</script>
