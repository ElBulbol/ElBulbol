---
import lancerGif from '../../lancer-deltarune.gif';
---

<aside class="secret-lancer" aria-label="A hidden personal corner">
  <button class="secret-launcher" type="button" aria-expanded="false" aria-controls="lancer-confirm-dialog" aria-label="A small hidden signal. Reveal it." data-secret-launcher>
    <span class="secret-sprite" aria-hidden="true"><img src={lancerGif.src} width="498" height="498" alt="" loading="lazy" decoding="async" /></span>
    <span class="secret-invitation" aria-hidden="true"><span class="secret-prompt">signal detected <i>_</i></span><span class="secret-question">Do you want to know more about me?</span><span class="secret-explore">[ explore <b>↵</b> ]</span></span>
  </button>
</aside>

<div class="lancer-overlay" data-secret-overlay aria-hidden="true" hidden>
  <section id="lancer-confirm-dialog" class="lancer-confirm" role="dialog" aria-modal="true" aria-labelledby="lancer-confirm-title" aria-describedby="lancer-confirm-copy" tabindex="-1">
    <header class="lancer-titlebar"><span class="lancer-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>[belal@portfolio ~]$ access ~/.config/belal_XD</span><button type="button" class="lancer-close" data-secret-close aria-label="Close personal-space confirmation">×</button></header>
    <form class="lancer-confirm-body" data-secret-form>
      <span class="lancer-path">~/lancer/heads-up</span>
      <h2 id="lancer-confirm-title">Lancer // Personal-only space</h2>
      <p id="lancer-confirm-copy">Everything past this point is about Belal — interests, hobbies, small stories, and whatever catches his attention. It is not the technical portfolio.</p>
      <label for="secret-confirmation">Type <code>I know</code> to continue.</label>
      <div class="secret-confirmation-row"><input id="secret-confirmation" data-secret-input autocomplete="off" spellcheck="false" placeholder="I know" /><button type="submit" data-secret-submit disabled>enter <span>↵</span></button></div>
      <p class="secret-status" aria-live="polite" data-secret-status>waiting for acknowledgement</p>
    </form>
  </section>
</div>

<style>
  .secret-lancer { display:flex; justify-content:center; margin:2rem auto 0; overflow:hidden; width:min(100%,342px); }
  .secret-launcher { align-items:center; appearance:none; background:transparent; border:0; color:var(--text-primary); cursor:pointer; display:flex; font:inherit; gap:.7rem; height:104px; overflow:hidden; padding:0; text-align:left; transition:width 260ms cubic-bezier(.2,.8,.2,1); width:58px; }
  .secret-sprite { align-self:flex-end; display:block; flex:0 0 104px; height:104px; transform:translateX(-52px); transition:transform 260ms cubic-bezier(.2,.8,.2,1); }.secret-sprite img { display:block; height:104px; object-fit:cover; width:104px; }
  .secret-invitation { border-left:1px solid var(--border-strong); display:grid; flex:0 0 226px; gap:.2rem; opacity:0; padding:.15rem 0 .15rem .7rem; transform:translateX(-8px); transition:opacity 130ms ease 40ms,transform 220ms ease 40ms; }.secret-prompt { color:var(--text-muted-2); font-size:10px; letter-spacing:.04em; }.secret-prompt i { animation:secret-cursor .8s steps(1,end) infinite; color:var(--accent); font-style:normal; }.secret-question { color:var(--text-primary); font-size:11px; line-height:1.45; }.secret-explore { color:var(--accent); font-size:10px; margin-top:.15rem; }.secret-explore b { font-size:11px; font-weight:400; }
  .secret-lancer:hover .secret-launcher,.secret-lancer:focus-within .secret-launcher,.secret-lancer.is-revealed .secret-launcher { width:332px; }.secret-lancer:hover .secret-sprite,.secret-lancer:focus-within .secret-sprite,.secret-lancer.is-revealed .secret-sprite { transform:none; }.secret-lancer:hover .secret-invitation,.secret-lancer:focus-within .secret-invitation,.secret-lancer.is-revealed .secret-invitation { opacity:1; transform:none; }.secret-launcher:focus-visible { outline:1px solid var(--accent); outline-offset:3px; }
  :global(body.secret-modal-open) { overflow:hidden; }.lancer-overlay { align-items:center; background:rgba(3,4,8,.82); display:flex; inset:0; justify-content:center; opacity:0; padding:1rem; pointer-events:none; position:fixed; transition:opacity 180ms ease; z-index:var(--z-overlay); }.lancer-overlay[hidden] { display:none; }.lancer-overlay.is-open { opacity:1; pointer-events:auto; }.lancer-confirm { background:var(--bg-panel-solid); border:1px solid var(--border-strong); box-shadow:0 20px 70px rgba(0,0,0,.6),0 0 36px rgba(122,162,247,.08); max-width:540px; opacity:0; transform:translateY(10px) scale(.985); transition:opacity 180ms ease,transform 180ms ease; width:100%; }.lancer-overlay.is-open .lancer-confirm { opacity:1; transform:none; }
  .lancer-titlebar { align-items:center; background:rgba(122,162,247,.035); border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:10px; gap:.65rem; padding:.6rem .8rem; }.lancer-dots { display:flex; gap:5px; }.lancer-dots i { background:var(--border-strong); border-radius:50%; height:7px; width:7px; }.lancer-dots i:first-child { background:var(--accent); }.lancer-close { background:transparent; border:0; color:var(--text-muted); cursor:pointer; font:inherit; font-size:19px; line-height:1; margin-left:auto; padding:0 .15rem; }.lancer-close:hover,.lancer-close:focus-visible { color:var(--text-primary); outline:1px solid var(--accent); outline-offset:3px; }
  .lancer-confirm-body { display:grid; gap:.8rem; padding:1.5rem; }.lancer-path { color:var(--accent); font-size:10px; }.lancer-confirm-body h2 { color:var(--text-primary); font-size:clamp(1.25rem,3vw,1.7rem); letter-spacing:-.04em; margin:0; }.lancer-confirm-body > p { color:var(--text-muted); font-size:12px; line-height:1.75; margin:0; }.lancer-confirm-body label { color:var(--text-muted); font-size:11px; margin-top:.35rem; }.lancer-confirm-body code { color:var(--accent); font-family:inherit; }.secret-confirmation-row { display:flex; }.secret-confirmation-row input { background:var(--bg-base); border:1px solid var(--border); border-right:0; color:var(--text-primary); font:inherit; font-size:12px; min-width:0; outline:none; padding:.7rem; width:100%; }.secret-confirmation-row input:focus { border-color:var(--accent); }.secret-confirmation-row button { background:var(--accent); border:1px solid var(--accent); color:var(--bg-base); cursor:pointer; font:inherit; font-size:11px; padding:.7rem .9rem; }.secret-confirmation-row button:disabled { background:var(--border); border-color:var(--border); color:var(--text-muted-2); cursor:not-allowed; }.secret-confirmation-row button:not(:disabled):hover,.secret-confirmation-row button:not(:disabled):focus-visible { background:var(--text-primary); outline:1px solid var(--accent); outline-offset:2px; }.secret-status { color:var(--text-muted-2)!important; font-size:10px!important; }.secret-status.is-ready { color:var(--term-green)!important; }
  @keyframes secret-cursor { 50% { opacity:0; } }
  @media (max-width:640px) { .secret-lancer { margin-top:1.5rem; width:294px; }.secret-launcher { height:92px; width:50px; }.secret-sprite { flex-basis:92px; height:92px; transform:translateX(-46px); }.secret-sprite img { height:92px; width:92px; }.secret-invitation { flex-basis:210px; }.secret-lancer.is-revealed .secret-launcher { width:294px; }.secret-lancer.is-revealed .secret-sprite { transform:none; }.secret-lancer.is-revealed .secret-invitation { opacity:1; transform:none; }.lancer-overlay { padding:.65rem; }.lancer-titlebar { font-size:9px; }.lancer-confirm-body { padding:1.25rem; } }
  @media (pointer:coarse) { .secret-lancer:hover .secret-launcher { width:50px; }.secret-lancer:hover .secret-sprite { transform:translateX(-46px); }.secret-lancer:hover .secret-invitation { opacity:0; transform:translateX(-8px); } }
  @media (prefers-reduced-motion:reduce) { .secret-launcher,.secret-sprite,.secret-invitation,.lancer-overlay,.lancer-confirm { transition:none; }.secret-prompt i { animation:none; } }
</style>

<script>
  const secret = document.querySelector('.secret-lancer'); const launcher = document.querySelector('[data-secret-launcher]') as HTMLButtonElement | null; const overlay = document.querySelector('[data-secret-overlay]') as HTMLElement | null; const input = document.querySelector('[data-secret-input]') as HTMLInputElement | null; const submit = document.querySelector('[data-secret-submit]') as HTMLButtonElement | null; const form = document.querySelector('[data-secret-form]') as HTMLFormElement | null; const closeButton = document.querySelector('[data-secret-close]') as HTMLButtonElement | null; const dialog = document.querySelector('#lancer-confirm-dialog') as HTMLElement | null; const status = document.querySelector('[data-secret-status]') as HTMLElement | null; const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; const touchDevice = window.matchMedia('(pointer: coarse)').matches; let lastFocus: HTMLElement | null = null; let closeTimer: number | undefined;
  const setRevealed = (revealed: boolean) => { secret?.classList.toggle('is-revealed', revealed); launcher?.setAttribute('aria-label', revealed ? 'Open the personal-space confirmation.' : 'A small hidden signal. Reveal it.'); };
  const closeSecret = () => { if (!overlay || !launcher) return; overlay.classList.remove('is-open'); overlay.setAttribute('aria-hidden', 'true'); launcher.setAttribute('aria-expanded', 'false'); document.body.classList.remove('secret-modal-open'); closeTimer = window.setTimeout(() => { overlay.hidden = true; }, reducedMotion ? 0 : 180); lastFocus?.focus(); };
  const openSecret = () => { if (!overlay || !launcher) return; window.clearTimeout(closeTimer); lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : launcher; if (input) input.value = ''; if (submit) submit.disabled = true; status?.classList.remove('is-ready'); if (status) status.textContent = 'waiting for acknowledgement'; overlay.hidden = false; window.requestAnimationFrame(() => overlay.classList.add('is-open')); overlay.setAttribute('aria-hidden', 'false'); launcher.setAttribute('aria-expanded', 'true'); document.body.classList.add('secret-modal-open'); window.setTimeout(() => input?.focus(), reducedMotion ? 0 : 180); };
  const updateConfirmation = () => { const ready = input?.value.trim().toLowerCase() === 'i know'; if (submit) submit.disabled = !ready; status?.classList.toggle('is-ready', ready); if (status) status.textContent = ready ? 'acknowledgement received — access unlocked' : 'waiting for acknowledgement'; };
  const focusable = () => dialog ? [...dialog.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')] : [];
  launcher?.addEventListener('focus', () => setRevealed(true)); launcher?.addEventListener('click', () => { if (touchDevice && !secret?.classList.contains('is-revealed')) { setRevealed(true); return; } openSecret(); }); input?.addEventListener('input', updateConfirmation); form?.addEventListener('submit', (event) => { event.preventDefault(); if (!submit?.disabled) window.location.assign('/~/.config/belal_XD'); }); closeButton?.addEventListener('click', closeSecret); overlay?.addEventListener('click', (event) => { if (event.target === overlay) closeSecret(); }); document.addEventListener('keydown', (event) => { if (!overlay?.classList.contains('is-open')) return; if (event.key === 'Escape') { event.preventDefault(); closeSecret(); return; } if (event.key !== 'Tab') return; const items = focusable(); if (!items.length) { event.preventDefault(); dialog?.focus(); return; } const first = items[0]; const last = items[items.length - 1]; if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); } if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } });
</script>
