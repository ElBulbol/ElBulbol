---
/**
 * About — Personal introduction section.
 * Features a cinematic, split layout and subtle scroll-reveal animations.
 */
---

<section id="about" class="about-section">
  <!-- Section heading -->
  <div class="about-heading reveal">
    <span class="terminal-prompt">[belal@portfolio ~]$</span><h2 class="heading-text">cat ~/about-me</h2>
  </div>

  <div class="about-container">
    
    <div class="about-visual reveal delay-1">
      <!-- User's photo -->
      <div class="photo-wrapper">
        <img src="/pfp.webp" alt="Belal Alshref" width="960" height="1280" loading="lazy" decoding="async" />
      </div>
      
      <div class="about-title">
        <h3 class="name">Belal Mohamed Amin Alshref</h3>
        <p class="role">// Builder. Geek. Analyst.</p>
      </div>
    </div>

    <div class="about-content">
      <div class="prose">
        <p class="reveal delay-2">
          I'm a Computer Science student, cybersecurity enthusiast, Linux/open-source geek, and builder. 
          My main interests lie at the intersection of security, networking, programming, and open-source technology.
        </p>
        
        <p class="reveal delay-3">
          I like going deep — understanding how things work beneath the surface rather than simply using them. 
          The terminal is where I'm most at home.
        </p>
        
        <p class="reveal delay-4">
          My work spans cybersecurity, systems, networking, and hands-on experimentation. 
          I also co-founded <a href="https://osc-must.github.io/OSC-MUST/" target="_blank" rel="noopener noreferrer" class="highlight">OSC-MUST</a>, where I serve as Technical Lead to share what I learn about Linux, Git, and open source.
        </p>
      </div>
    </div>
    
  </div>
</section>

<style>
  .about-section {
    padding: 6rem 2rem 8rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-base);
    gap: 3rem;
  }

  /* Section heading — terminal command */
  .about-heading {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    width: 100%;
    max-width: 1320px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.75rem;
  }

  .terminal-prompt {
    color: var(--accent);
    font-size: clamp(0.85rem, 1.5vw, 1.15rem);
    font-weight: 700;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .heading-text {
    color: var(--text-primary);
    font-size: clamp(1.65rem, 3.4vw, 3rem);
    font-weight: 700;
    font-family: var(--font-mono);
    margin: 0;
  }


  /* Grid container */
  .about-container {
    max-width: 1320px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .about-container {
      grid-template-columns: 0.9fr 1.55fr;
      align-items: start;
      gap: 6rem;
    }
  }

  /* Visual Column */
  .about-visual {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .photo-wrapper {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    border-radius: var(--radius-structural);
    border: 1px solid var(--border-strong);
    background-color: var(--bg-panel-solid);
    overflow: hidden;
    position: relative;
    filter: grayscale(70%) contrast(1.1);
    transition: filter 0.5s ease;
  }

  .photo-wrapper:hover {
    filter: grayscale(0%) contrast(1);
  }

  .photo-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-title .name {
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .about-title .role {
    color: var(--text-muted-2);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  /* Content Column */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.65rem;
  }

  .prose p {
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    color: var(--text-muted);
    line-height: 1.85;
    max-width: 680px;
  }

  .prose .highlight {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .prose .highlight:hover {
    border-bottom-color: var(--accent);
  }

  /* Scroll Reveal Animation Classes */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays for staggered entrance */
  .delay-1 { transition-delay: 150ms; }
  .delay-2 { transition-delay: 300ms; }
  .delay-3 { transition-delay: 450ms; }
  .delay-4 { transition-delay: 600ms; }

  @media (max-width: 640px) {
    .about-heading { align-items: flex-start; flex-wrap: wrap; gap: 0.35rem 0.55rem; }
    .terminal-prompt { font-size: 0.78rem; padding-top: 0.35rem; }
    .heading-text { font-size: clamp(1.35rem, 7vw, 1.8rem); }
  }

  /* Respect motion rules */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Simple IntersectionObserver to trigger scroll reveal animations
  const observerOptions = {
    root: null,
    rootMargin: '0px 0px -10% 0px',
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target); // Only animate once
      }
    });
  }, observerOptions);

  // Initialize observer on all .reveal elements
  const initReveal = () => {
    // Check for reduced motion to avoid unnecessary observation
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
      return;
    }

    document.querySelectorAll('.reveal').forEach(el => {
      observer.observe(el);
    });
  };

  // Run on load. If the boot screen is active, it runs silently in the background.
  // The layout will render invisible until scrolled to anyway.
  initReveal();
</script>
