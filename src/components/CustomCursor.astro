---
/**
 * CustomCursor — instant JS-driven cursor using the Lancer cursor set.
 * 
 * Falls back to native cursors on touch devices or if reduced-motion is preferred.
 * NO transition on movement — cursor tracks the mouse 1:1 instantly.
 */
---

<div id="custom-cursor" class="custom-cursor" aria-hidden="true"></div>

<style>
  /* Hide native cursor globally when custom cursor is active */
  :global(html.custom-cursor-active),
  :global(html.custom-cursor-active *) {
    cursor: none !important;
  }

  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    pointer-events: none;
    z-index: 9999;
    background-image: url('/cursors/lancer-normal.cur');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    /* NO transition on transform — must be instant */
    will-change: transform;
    opacity: 0;
  }

  /* Interaction states — only the image swaps, no scale tricks */
  .custom-cursor.is-hovering {
    background-image: url('/cursors/lancer-help.cur');
  }

  .custom-cursor.is-disabled {
    background-image: url('/cursors/lancer-unavailable.cur');
  }

  .custom-cursor.is-visible {
    opacity: 1;
  }

  /* Fallback for touch / reduced motion */
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .custom-cursor {
      display: none !important;
    }
  }
</style>

<script>
  const cursor = document.getElementById('custom-cursor');
  let isTouch = matchMedia('(pointer: coarse)').matches;
  let isReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cursor && !isTouch && !isReducedMotion) {
    document.documentElement.classList.add('custom-cursor-active');
    
    // Instant cursor tracking — no easing, no lag
    window.addEventListener('mousemove', (e) => {
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      
      if (!cursor.classList.contains('is-visible')) {
        cursor.classList.add('is-visible');
      }
    }, { passive: true });

    // Handle interactive elements — swap cursor image
    const interactiveSelector = 'a, button, input, select, textarea, [role="button"], label, .mode-switch-btn';
    
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      const interactive = target.closest(interactiveSelector);
      
      if (interactive) {
        if (interactive.hasAttribute('disabled') || interactive.getAttribute('aria-disabled') === 'true') {
          cursor.classList.add('is-disabled');
          cursor.classList.remove('is-hovering');
        } else {
          cursor.classList.add('is-hovering');
          cursor.classList.remove('is-disabled');
        }
      } else {
        cursor.classList.remove('is-hovering');
        cursor.classList.remove('is-disabled');
      }
    }, { passive: true });
    
    // Hide when leaving window
    document.addEventListener('mouseleave', () => {
      cursor.classList.remove('is-visible');
    });
    
    document.addEventListener('mouseenter', () => {
      cursor.classList.add('is-visible');
    });
  }
</script>
