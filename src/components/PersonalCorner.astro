---
import { personalPosts, personalShelves } from '../data/personal.js';
---

<section class="personal-corner" aria-labelledby="personal-corner-title">
  <header class="corner-titlebar"><span class="corner-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>[belal@portfolio ~]$ cat ~/.config/belal_XD</span></header>
  <div class="corner-body">
    <div class="corner-intro"><span>~/.config/belal_XD</span><h1 id="personal-corner-title">Belal // Off the Record</h1><p>This is the stuff that isn't on my résumé.</p><small>The portfolio tells you what I do. This is the less organized collection of everything else.</small></div>
    <div class="corner-shelves" aria-label="Personal interests and hobbies">
      {personalShelves.map((shelf) => <section class="corner-shelf"><h2>{shelf.title}</h2><ul>{shelf.items.map((item) => <li>{item}</li>)}</ul></section>)}
    </div>
    <section class="corner-blog" aria-labelledby="corner-blog-title">
      <div class="corner-blog-heading"><div><span>~/.config/belal_XD/notes</span><h2 id="corner-blog-title">blog</h2></div><small>{personalPosts.length.toString().padStart(2, '0')} {personalPosts.length === 1 ? 'entry' : 'entries'}</small></div>
      <div class="corner-posts">
        {personalPosts.map((post) => <details class="corner-post"><summary><span><b>{post.category}</b><time>{post.date}</time></span><strong>{post.title}</strong><p>{post.excerpt}</p></summary><div>{post.content}</div>{post.image && <img src={post.image} alt={post.imageAlt || ''} loading="lazy" />}</details>)}
      </div>
    </section>
  </div>
  <footer><a href="/" aria-label="Return to Belal's portfolio">← return to portfolio</a><span>this room stays off the record</span></footer>
</section>

<style>
  .personal-corner { background:var(--bg-panel-solid); border:1px solid var(--border-strong); box-shadow:0 20px 70px rgba(0,0,0,.45),0 0 36px rgba(122,162,247,.06); margin:0 auto; max-width:880px; }.corner-titlebar { align-items:center; background:rgba(122,162,247,.035); border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:11px; gap:.65rem; padding:.65rem .85rem; }.corner-dots { display:flex; gap:5px; }.corner-dots i { background:var(--border-strong); border-radius:50%; height:7px; width:7px; }.corner-dots i:first-child { background:var(--accent); }.corner-body { padding:clamp(1.25rem,3vw,2.25rem); }.corner-intro { border-left:2px solid var(--accent); max-width:680px; padding-left:1rem; }.corner-intro > span,.corner-blog-heading span { color:var(--accent); font-size:10px; }.corner-intro h1,.corner-blog-heading h2 { color:var(--text-primary); font-size:clamp(1.4rem,3vw,2rem); letter-spacing:-.04em; margin:.25rem 0 0; }.corner-intro p { color:var(--text-muted); font-size:var(--font-size-sm); line-height:1.7; margin:.75rem 0 0; }.corner-intro small { color:var(--text-muted-2); display:block; font-size:12px; line-height:1.65; margin-top:.35rem; }.corner-shelves { display:grid; grid-template-columns:repeat(3,1fr); margin-top:2rem; }.corner-shelf { border:1px solid var(--border); border-right:0; min-height:154px; padding:1rem; }.corner-shelf:last-child { border-right:1px solid var(--border); }.corner-shelf h2 { color:var(--accent); font-size:11px; font-weight:500; letter-spacing:.08em; margin:0 0 .85rem; text-transform:uppercase; }.corner-shelf ul { color:var(--text-muted); font-size:11px; line-height:1.6; list-style:none; margin:0; padding:0; }.corner-shelf li { margin-top:.5rem; padding-left:.8rem; position:relative; }.corner-shelf li::before { color:var(--accent); content:'>'; left:0; position:absolute; }.corner-blog { border-top:1px solid var(--border); margin-top:2rem; padding-top:1rem; }.corner-blog-heading { align-items:end; display:flex; justify-content:space-between; margin-bottom:.8rem; }.corner-blog-heading h2 { font-size:var(--font-size-xl); }.corner-blog-heading > small { color:var(--text-muted-2); font-size:10px; }.corner-posts { border:1px solid var(--border); }.corner-post + .corner-post { border-top:1px solid var(--border); }.corner-post summary { cursor:pointer; list-style:none; padding:1rem; }.corner-post summary::-webkit-details-marker { display:none; }.corner-post summary > span { display:flex; gap:.6rem; }.corner-post summary b,.corner-post summary time { color:var(--text-muted-2); font-size:10px; font-weight:400; }.corner-post summary b { color:var(--accent); text-transform:uppercase; }.corner-post summary strong { color:var(--text-primary); display:block; font-size:13px; margin-top:.35rem; }.corner-post summary p { color:var(--text-muted); font-size:11px; line-height:1.65; margin:.35rem 0 0; max-width:650px; }.corner-post summary:hover,.corner-post summary:focus-visible { background:rgba(122,162,247,.05); outline:1px solid var(--accent); outline-offset:-1px; }.corner-post > div { border-top:1px solid var(--border); color:var(--text-muted); font-size:12px; line-height:1.75; padding:1rem; }.corner-post img { border-top:1px solid var(--border); display:block; height:auto; max-height:360px; object-fit:cover; width:100%; }.personal-corner footer { border-top:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:10px; justify-content:space-between; padding:.7rem .85rem; }.personal-corner footer a { color:var(--accent); text-decoration:none; }.personal-corner footer a:hover,.personal-corner footer a:focus-visible { color:var(--text-primary); outline:none; }
  @media (max-width:640px) { .corner-titlebar { font-size:9px; }.corner-shelves { grid-template-columns:1fr; }.corner-shelf,.corner-shelf:last-child { border-right:1px solid var(--border); border-bottom:0; min-height:auto; }.corner-shelf:last-child { border-bottom:1px solid var(--border); }.personal-corner footer { gap:1rem; } }
</style>
