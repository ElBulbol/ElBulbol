---
import personalPhoto from '../../lancer_photo_cute_personal.jpg';
import { personalNotes, personalPosts, personalSections } from '../data/personal.js';
---

<main class="personal-space" aria-labelledby="personal-space-title">
  <header class="personal-command"><span class="command-dot"></span><span>[belal@portfolio ~]$ cd ~/.config/belal_XD</span><button type="button" data-personal-back aria-label="Return to the professional portfolio">← back to portfolio</button></header>
  <div class="personal-inner">
    <section class="personal-hero">
      <div class="personal-copy"><span class="personal-path">~/.config/belal_XD</span><h1 id="personal-space-title">Lancer // Off the Record</h1><p class="personal-message">Yeah... this part is still under construction.</p><p class="personal-note">You found the secret page. Apparently I need to figure out what I want to tell you about myself first.</p></div>
      <figure class="personal-photo"><img src={personalPhoto.src} width={personalPhoto.width} height={personalPhoto.height} alt="Lancer, keeping watch over the unfinished personal corner" decoding="async" /><figcaption>personal mode // unfinished on purpose</figcaption></figure>
    </section>
    <p class="personal-intro">A few things about me that do not belong on a résumé are supposed to live here. They are not ready yet, but the shelves are waiting.</p>
    <section class="personal-soundtrack" aria-labelledby="personal-soundtrack-title">
      <div><span>~/audio</span><h2 id="personal-soundtrack-title">secret soundtrack</h2></div>
      <p>one play only // no autoplay until you confirm you know where you are</p>
      <iframe data-personal-audio data-src="https://www.youtube.com/embed/GAhBQH0Kf1I?autoplay=1&amp;controls=0&amp;loop=0&amp;playsinline=1&amp;rel=0&amp;modestbranding=1" title="Personal-space soundtrack" loading="lazy" allow="autoplay; encrypted-media" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </section>
    <div class="personal-shelves">{personalSections.map((section) => <section class="personal-shelf"><h2>{section.title}</h2>{section.items.length ? <ul>{section.items.map((item) => <li><strong>{item.title}</strong>{item.description && <span>{item.description}</span>}{item.image && <img src={item.image} alt={item.imageAlt || ''} loading="lazy" />}</li>)}</ul> : <p class="empty-slot">nothing here yet<span>_</span></p>}</section>)}</div>
    <section class="personal-blog" aria-labelledby="personal-blog-title"><div class="personal-section-heading"><div><span>~/notes</span><h2 id="personal-blog-title">blog</h2></div><small>{personalPosts.length.toString().padStart(2, '0')} posts</small></div>{personalPosts.length ? <div class="personal-posts">{personalPosts.map((post) => <article class="personal-post"><div class="personal-post-meta"><span>{post.category}</span><time>{post.date}</time></div><h3>{post.title}</h3><p>{post.excerpt}</p>{post.content && <div class="personal-post-content">{post.content}</div>}{post.image && <img src={post.image} alt={post.imageAlt || ''} loading="lazy" />}</article>)}</div> : <p class="empty-slot large">the first post is still loading from my brain<span>_</span></p>}</section>
    {personalNotes.length > 0 && <section class="personal-notes"><h2>notes</h2>{personalNotes.map((note) => <article><div class="personal-post-meta"><span>note</span><time>{note.date}</time></div><h3>{note.title}</h3><p>{note.content}</p></article>)}</section>}
  </div>
  <footer class="personal-footer"><span>nothing here is a case study</span><button type="button" data-personal-back>$ cd ~/portfolio</button><span>esc to return</span></footer>
</main>

<style>
  .personal-space { background:radial-gradient(circle at 75% 15%,rgba(122,162,247,.08),transparent 35%),var(--bg-base); color:var(--text-primary); min-height:100vh; }.personal-command { align-items:center; border-bottom:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:11px; gap:.6rem; padding:.7rem 1.25rem; }.command-dot { background:var(--accent); border-radius:50%; height:7px; width:7px; }.personal-command button,.personal-footer button { background:transparent; border:0; color:var(--accent); cursor:pointer; font:inherit; margin-left:auto; padding:0; }.personal-command button:hover,.personal-command button:focus-visible,.personal-footer button:hover,.personal-footer button:focus-visible { color:var(--text-primary); outline:1px solid var(--accent); outline-offset:3px; }.personal-inner { margin:0 auto; max-width:1120px; padding:clamp(2rem,7vw,6rem) clamp(1rem,4vw,3rem) 3rem; }.personal-hero { align-items:center; display:grid; gap:clamp(2rem,8vw,7rem); grid-template-columns:minmax(0,1fr) minmax(220px,360px); }.personal-copy { border-left:2px solid var(--accent); padding-left:1.25rem; }.personal-path,.personal-section-heading > div > span,.personal-soundtrack > div > span { color:var(--accent); font-size:10px; }.personal-copy h1 { font-size:clamp(2rem,6vw,4.5rem); letter-spacing:-.07em; line-height:.95; margin:.5rem 0 1.5rem; max-width:650px; }.personal-message { color:var(--text-primary); font-size:clamp(1.1rem,2.4vw,1.6rem); line-height:1.4; margin:0; }.personal-note { color:var(--text-muted); font-size:13px; line-height:1.8; margin:1rem 0 0; max-width:560px; }.personal-photo { margin:0; transform:rotate(2deg); }.personal-photo img { background:var(--bg-panel-solid); border:1px solid var(--border-strong); box-shadow:14px 14px 0 rgba(122,162,247,.08); display:block; height:auto; max-height:420px; object-fit:cover; width:100%; }.personal-photo figcaption { color:var(--text-muted-2); font-size:10px; margin-top:.7rem; text-align:right; }.personal-intro { border-bottom:1px solid var(--border); border-top:1px solid var(--border); color:var(--text-muted); font-size:12px; line-height:1.8; margin:clamp(2.5rem,7vw,6rem) 0 0; max-width:760px; padding:1rem 0; }.personal-soundtrack { border-bottom:1px solid var(--border); border-top:1px solid var(--border); margin-top:2rem; padding:1rem 0; position:relative; }.personal-soundtrack h2 { color:var(--text-primary); font-size:var(--font-size-xl); letter-spacing:-.04em; margin:0; }.personal-soundtrack p { color:var(--text-muted-2); font-size:10px; margin-top:.35rem; }.personal-soundtrack iframe { border:0; height:1px; opacity:0; pointer-events:none; position:absolute; width:1px; }.personal-shelves { display:grid; grid-template-columns:repeat(3,1fr); margin-top:1.5rem; }.personal-shelf { border:1px solid var(--border); border-right:0; min-height:150px; padding:1.1rem; }.personal-shelf:last-child { border-right:1px solid var(--border); }.personal-shelf h2,.personal-section-heading h2,.personal-notes h2 { color:var(--text-primary); font-size:var(--font-size-xl); letter-spacing:-.04em; margin:0; }.personal-shelf h2 { color:var(--accent); font-size:12px; text-transform:uppercase; }.personal-shelf ul { color:var(--text-muted); font-size:11px; line-height:1.6; list-style:none; margin:.9rem 0 0; padding:0; }.personal-shelf li { border-top:1px solid var(--border); display:grid; gap:.2rem; padding:.7rem 0; }.personal-shelf li strong { color:var(--text-primary); font-weight:500; }.personal-shelf li span { color:var(--text-muted-2); }.personal-shelf li img { height:auto; margin-top:.45rem; max-height:130px; object-fit:cover; width:100%; }.personal-posts { border:1px solid var(--border); margin-top:1rem; }.personal-post + .personal-post { border-top:1px solid var(--border); }.personal-post { padding:1rem; }.personal-post-meta { display:flex; gap:.8rem; color:var(--text-muted-2); font-size:10px; }.personal-post-meta span { color:var(--accent); text-transform:uppercase; }.personal-post h3 { color:var(--text-primary); font-size:13px; margin-top:.45rem; }.personal-post p,.personal-post-content { color:var(--text-muted); font-size:11px; line-height:1.7; margin-top:.35rem; }.personal-post img { display:block; height:auto; margin-top:.7rem; max-height:360px; object-fit:cover; width:100%; }.empty-slot { color:var(--text-muted-2); font-size:11px; margin-top:2.2rem; }.empty-slot span { animation:personal-cursor .8s steps(1,end) infinite; color:var(--accent); }.personal-blog,.personal-notes { border-top:1px solid var(--border); margin-top:3rem; padding-top:1rem; }.personal-section-heading { align-items:end; display:flex; justify-content:space-between; }.personal-section-heading h2 { font-size:var(--font-size-2xl); }.personal-section-heading small { color:var(--text-muted-2); font-size:10px; }.empty-slot.large { border:1px dashed var(--border); margin:1rem 0 0; padding:1.5rem; }.personal-footer { border-top:1px solid var(--border); color:var(--text-muted-2); display:flex; font-size:10px; gap:1rem; justify-content:space-between; padding:1rem 1.25rem; }.personal-footer button { margin-left:0; }.personal-footer button:hover,.personal-footer button:focus-visible { outline-offset:2px; }@keyframes personal-cursor { 50% { opacity:0; } }
  @media (max-width:700px) { .personal-command { font-size:9px; }.personal-hero { grid-template-columns:1fr; }.personal-photo { margin:0 auto; max-width:260px; order:-1; }.personal-copy h1 { font-size:clamp(2.25rem,13vw,4rem); }.personal-shelves { grid-template-columns:1fr; }.personal-shelf,.personal-shelf:last-child { border-bottom:0; border-right:1px solid var(--border); min-height:110px; }.personal-shelf:last-child { border-bottom:1px solid var(--border); }.personal-footer { flex-wrap:wrap; } }
  @media (prefers-reduced-motion:reduce) { .empty-slot span { animation:none; }.personal-photo { transform:none; } }
</style>
