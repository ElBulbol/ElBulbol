---
import { currentLearning } from '../data/currentLearning.js';
---

<section id="currently-learning" class="learning-section">
  <div class="learning-heading">
    <span class="terminal-prompt">[belal@portfolio ~]$</span><h2 class="heading-text">ps aux | grep currently_working_on.sh</h2>
  </div>

  <div class="learning-container">
    <p class="learning-intro">Active skill-building processes, running without a guided path.</p>
    <div class="process-window">
      <div class="process-titlebar"><span></span><span></span><span></span><b>currently_working_on.sh</b></div>
      <div class="process-table-wrap">
        <table data-learning-table>
          <thead><tr><th scope="col">PID</th><th scope="col">STATE</th><th scope="col">PROCESS</th><th scope="col" class="cpu-heading">%CPU</th></tr></thead>
          {currentLearning.map((item, index) => (
            <tbody class:list={['process-group', { 'is-active': item.status === 'in_progress' }]} data-learning-track={index}>
              <tr class="process-row">
                <td class="process-id">{String(index + 1).padStart(4, '0')}</td>
                <td><span class="process-state" aria-label={item.status === 'in_progress' ? 'running, in progress' : 'running, learning'}>R</span></td>
                <td class="process-cell"><span class="process-main"><strong>{item.track}</strong><small>{item.focus}</small></span><span class="process-meta"><span class="tools-label">TOOLS</span><span class="tool-row" aria-label={`${item.track} tools`}>{item.tools.map((tool) => <span>{tool}</span>)}</span>{item.note && <span class="process-note">{item.note}</span>}</span></td>
                <td class="cpu-cell"><span class="cpu-meter" aria-label="active learning process"><i></i><i></i><i></i></span></td>
              </tr>
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .learning-section { align-items:center; background:var(--bg-base); display:flex; flex-direction:column; gap:2rem; padding:6rem 2rem 8rem; }
  .learning-heading { align-items:baseline; border-bottom:1px solid var(--border); display:flex; gap:.7rem; max-width:1320px; padding-bottom:1.75rem; width:100%; }.terminal-prompt { color:var(--accent); font-family:var(--font-mono); font-size:clamp(.85rem,1.5vw,1.15rem); font-weight:700; white-space:nowrap; }.heading-text { color:var(--text-primary); font-family:var(--font-mono); font-size:clamp(1.65rem,3.4vw,3rem); font-weight:700; margin:0; }
  .learning-container { display:flex; flex-direction:column; gap:1.5rem; max-width:1320px; width:100%; }.learning-intro { color:var(--text-muted); font-size:clamp(1rem,1.35vw,1.2rem); line-height:1.8; margin:0; }
  .process-window { background:var(--bg-panel-solid); border:1px solid var(--border); }.process-titlebar { align-items:center; background:var(--bg-base); border-bottom:1px solid var(--border); display:flex; gap:.4rem; padding:.8rem 1rem; }.process-titlebar span { background:var(--border-strong); border-radius:50%; height:8px; width:8px; }.process-titlebar span:first-child { background:var(--term-red); }.process-titlebar span:nth-child(2) { background:var(--term-yellow); }.process-titlebar span:nth-child(3) { background:var(--term-green); }.process-titlebar b { color:var(--text-muted-2); font-size:11px; font-weight:500; margin-left:.4rem; }
  .process-table-wrap { overflow-x:auto; }.process-table-wrap table { border-collapse:collapse; min-width:760px; width:100%; }.process-table-wrap th { background:rgba(122,162,247,.035); border-bottom:1px solid var(--border); color:var(--text-muted-2); font-size:11px; font-weight:500; letter-spacing:.08em; padding:.8rem 1rem; text-align:left; }.cpu-heading,.cpu-cell { text-align:right!important; }.process-group { opacity:1; }.process-row td { border-bottom:1px solid var(--border); padding:1rem; transition:background-color 180ms ease; }.process-group:hover .process-row td, .process-group:focus-within .process-row td { background:rgba(122,162,247,.05); }.process-id { color:var(--accent); font-size:12px; }.process-state { color:var(--term-green); font-size:14px; }.process-group.is-active .process-state { animation:state-blink 1.2s steps(1,end) infinite; color:var(--term-cyan); }.process-row strong { color:var(--text-primary); display:block; font-size:var(--font-size-base); font-weight:600; }.process-row small { color:var(--text-muted-2); display:block; font-size:13px; line-height:1.6; margin-top:.3rem; max-width:880px; }.cpu-meter { display:inline-flex; gap:4px; vertical-align:middle; }.cpu-meter i { background:var(--border-strong); display:block; height:12px; width:4px; }.cpu-meter i:first-child { background:var(--accent); }.is-active .cpu-meter i { animation:cpu-tick 1.1s ease-in-out infinite; background:var(--term-cyan); }.is-active .cpu-meter i:nth-child(2) { animation-delay:.15s; }.is-active .cpu-meter i:nth-child(3) { animation-delay:.3s; }
  .process-detail td { border-bottom:1px solid var(--border); padding:0 1rem 1.2rem 6.8rem; }.process-detail > td > div { align-items:flex-start; display:flex; flex-wrap:wrap; gap:.75rem 1rem; }.tools-label { color:var(--text-muted-2); font-size:11px; letter-spacing:.06em; padding-top:.4rem; }.tool-row { display:flex; flex-wrap:wrap; gap:.5rem; }.tool-row span { background:var(--bg-base); border:1px solid var(--border); color:var(--text-muted-2); font-size:12px; padding:.3rem .65rem; }.process-detail p { border-left:2px solid var(--accent); color:var(--text-muted-2); font-size:12px; line-height:1.7; margin:0; max-width:760px; padding-left:.75rem; width:100%; }
  .process-cell { min-width:0; }.process-main { align-items:baseline; display:flex; gap:.85rem; min-width:0; }.process-row strong { display:inline; }.process-row small { display:inline; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.process-meta { align-items:center; display:flex; flex-wrap:wrap; gap:.65rem; margin-top:.55rem; min-width:0; }.tool-row { display:inline-flex; flex-wrap:nowrap; }.process-note { border-left:2px solid var(--accent); color:var(--text-muted-2); flex-basis:100%; font-size:12px; line-height:1.7; overflow:hidden; padding-left:.75rem; text-overflow:ellipsis; white-space:nowrap; }
  .process-table-wrap.is-observing .process-group { opacity:0; transform:translateY(8px); }.process-table-wrap.is-observing .process-group.is-visible { opacity:1; transform:none; transition:opacity 260ms ease var(--track-delay),transform 260ms ease var(--track-delay); }
  @keyframes state-blink { 50% { opacity:.35; } } @keyframes cpu-tick { 50% { opacity:.25; transform:translateY(2px); } }
  @media (max-width:640px) { .learning-section { padding:5rem 1rem 6rem; }.learning-heading { align-items:flex-start; flex-wrap:wrap; gap:.35rem .55rem; }.terminal-prompt { font-size:.78rem; padding-top:.35rem; }.heading-text { font-size:clamp(1.15rem,5vw,1.5rem); }.process-table-wrap table { min-width:720px; }.process-detail td { padding-left:6.8rem; } }
  @media (prefers-reduced-motion:reduce) { .process-group.is-active .process-state, .is-active .cpu-meter i { animation:none; }.process-table-wrap.is-observing .process-group { opacity:1; transform:none; } }
</style>

<script>
  const learningTable = document.querySelector('[data-learning-table]');
  if (learningTable && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const groups = [...learningTable.querySelectorAll('[data-learning-track]')] as HTMLElement[];
    const tableWrap = learningTable.closest('.process-table-wrap');
    tableWrap?.classList.add('is-observing');
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      (entry.target as HTMLElement).classList.toggle('is-visible', entry.isIntersecting);
    }), { threshold: 0.2 });
    groups.forEach((group, index) => { group.style.setProperty('--track-delay', `${index * 70}ms`); observer.observe(group); });
  }
</script>
