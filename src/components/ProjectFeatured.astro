---
import ProjectFeaturedHeader from './ProjectFeaturedHeader.astro';

const { project } = Astro.props;
const controlPath = [
  { name: 'pfSense', role: 'NETWORK PERIMETER' },
  { name: 'Suricata IDS/IPS', role: 'NETWORK INSPECTION' },
  { name: 'ModSecurity', role: 'HTTP INSPECTION / WAF' },
];
---

<article class="featured-project reveal" data-slug={project.slug}>
  <!-- Shared Header -->
  <ProjectFeaturedHeader project={project} />

  <!-- Attack Flow Diagram -->
  {project.attacks && project.defense && (
    <div class="attack-flow reveal delay-1">
      <h4 class="flow-heading">Inbound request → security controls → application</h4>
      
      <div class="flow-diagram">
        <div class="flow-node node-attacker">
          <div class="node-icon">⟩_</div>
          <div class="node-label">Attacker</div>
        </div>
        <div class="flow-connector">
          <span>INBOUND REQUEST</span><i aria-hidden="true">↓</i>
        </div>

        {controlPath.map((control) => {
          const defense = project.defense.find((item: any) => item.name === control.name);
          return defense && (
            <Fragment>
            <div class="flow-node node-defense" data-defense={defense.name}>
              <div class="node-status">ACTIVE</div>
              <div class="node-role">{control.role}</div>
              <div class="node-label">{defense.name}</div>
              <div class="node-detail">{defense.description}</div>
            </div>
            <div class="flow-connector"><span>INSPECT / ENFORCE</span><i aria-hidden="true">↓</i></div>
            </Fragment>
          );
        })}

        <div class="flow-node node-target">
          <div class="node-icon">◈</div>
          <div class="node-role">PROTECTED WORKLOAD</div>
          <div class="node-label">Real Estate Web App</div>
          <div class="node-detail">Flask · MySQL · HTML/CSS/JS</div>
        </div>
      </div>
      <p class="flow-note">Each control is positioned before the application: traffic is filtered, inspected, and then allowed to reach the workload.</p>
    </div>
  )}

  <!-- Vulnerability Cards -->
  {project.attacks && (
    <div class="vuln-section reveal delay-2">
      <h4 class="section-label">// Vulnerabilities</h4>
      <div class="vuln-grid">
        {project.attacks.map((attack: any) => (
          <button class="vuln-card" data-vuln={attack.name} aria-expanded="false">
            <div class="vuln-header">
              <span class="vuln-name">{attack.name}</span>
              <span class="vuln-status">
                <span class="status-dot status-vuln"></span>VULNERABLE
              </span>
            </div>
            <div class="vuln-body">
              {attack.payload && (
                <code class="vuln-payload">{attack.payload}</code>
              )}
              {attack.description && (
                <p class="vuln-desc">{attack.description}</p>
              )}
              <span class="vuln-mitigated">
                <span class="status-dot status-safe"></span>MITIGATED
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- Certification -->
  {project.certification && (
    <div class="fp-cert reveal delay-3">
      <span class="cert-icon">⎔</span>
      Part of <strong>{project.certification.name}</strong> training — {project.certification.issuer}, {project.certification.date}
      {project.certification.link && (
        <a href={project.certification.link} target="_blank" rel="noopener noreferrer" class="cert-link">[View Certificate]</a>
      )}
    </div>
  )}
</article>

<style>
  .featured-project {
    background-color: var(--bg-panel-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    padding: 2.5rem;
    width: 100%;
    transition: border-color 0.3s ease;
  }

  .featured-project:hover {
    border-color: var(--border-strong);
  }

  /* Attack Flow Diagram */
  .attack-flow {
    margin-bottom: 2.5rem;
    padding: 2rem;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
  }

  .flow-heading {
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    text-align: center;
  }

  .flow-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .flow-node {
    width: 100%;
    max-width: 400px;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    background: var(--bg-panel-solid);
    text-align: center;
    position: relative;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .flow-node:hover {
    border-color: var(--border-strong);
  }

  .node-icon {
    font-size: var(--font-size-lg);
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .node-label {
    font-size: var(--font-size-base);
    color: var(--text-primary);
    font-weight: 600;
  }

  .node-role {
    color: var(--text-muted-2);
    font-size: 10px;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .node-detail {
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
    margin-top: 0.25rem;
    line-height: 1.55;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.2s ease, opacity 0.2s ease;
  }

  .flow-node:hover .node-detail, .flow-node:focus-within .node-detail {
    max-height: 90px;
    opacity: 1;
  }

  .node-status {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--term-green);
    font-weight: 700;
  }

  /* Node type colors */
  .node-attacker { border-color: var(--term-red); }
  .node-attacker .node-icon { color: var(--term-red); }

  .node-target { border-color: var(--term-yellow); }
  .node-target .node-icon { color: var(--term-yellow); }

  .node-defense:hover { border-color: var(--accent); background: rgba(122, 162, 247, 0.05); }

  /* Labeled connections make the order of controls explicit. */
  .flow-connector {
    align-items: center;
    color: var(--text-muted-2);
    display: flex;
    flex-direction: column;
    font-size: 9px;
    gap: 0.15rem;
    height: 38px;
    justify-content: center;
    letter-spacing: 0.08em;
    position: relative;
    width: 100%;
  }

  .flow-connector::before {
    background: var(--border);
    content: '';
    height: 100%;
    left: 50%;
    position: absolute;
    top: 0;
    width: 1px;
    z-index: 0;
  }

  .flow-connector span, .flow-connector i {
    background: var(--bg-base);
    position: relative;
    z-index: 1;
  }

  .flow-connector span { padding: 0 0.4rem; }

  .flow-connector i {
    color: var(--accent);
    font-size: 13px;
    font-style: normal;
    line-height: 1;
  }

  .flow-note {
    color: var(--text-muted-2);
    font-size: 11px;
    line-height: 1.65;
    margin: 1.25rem auto 0;
    max-width: 520px;
    text-align: center;
  }

  /* Vulnerability Cards */
  .vuln-section {
    margin-bottom: 2.5rem;
  }

  .section-label {
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .vuln-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .vuln-card {
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    padding: 1rem;
    text-align: left;
    font-family: var(--font-mono);
    transition: border-color 0.2s ease;
    width: 100%;
    display: block;
    cursor: pointer;
  }

  .vuln-card:hover, .vuln-card:focus-visible {
    border-color: var(--border-strong);
    outline: none;
  }

  .vuln-card:focus-visible {
    border-color: var(--accent);
  }

  .vuln-card[aria-expanded="true"] {
    border-color: var(--term-red);
  }

  .vuln-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .vuln-name {
    font-size: var(--font-size-sm);
    color: var(--text-primary);
    font-weight: 600;
  }

  .vuln-status {
    font-size: 10px;
    color: var(--term-red);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-vuln { background: var(--term-red); }
  .status-safe { background: var(--term-green); }

  .vuln-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding-top 0.3s ease;
    padding-top: 0;
  }

  .vuln-card[aria-expanded="true"] .vuln-body {
    max-height: 200px;
    padding-top: 0.75rem;
  }

  .vuln-payload {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--term-red);
    background: rgba(247, 118, 142, 0.08);
    padding: 0.4rem 0.6rem;
    border-radius: 3px;
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .vuln-desc {
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .vuln-mitigated {
    font-size: 10px;
    color: var(--term-green);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Certification */
  .fp-cert {
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cert-icon {
    color: var(--term-yellow);
  }

  .fp-cert strong {
    color: var(--text-muted);
  }

  .cert-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    margin-left: 0.5rem;
  }

  .cert-link:hover {
    color: var(--text-primary);
  }

  /* Responsive */
  @media (max-width: 600px) {
    .featured-project {
      padding: 1.5rem;
    }

    .attack-flow {
      padding: 1rem;
    }

    .vuln-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Scroll reveal classes */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-1 { transition-delay: 150ms; }
  .delay-2 { transition-delay: 300ms; }
  .delay-3 { transition-delay: 450ms; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Vulnerability card expand/collapse
  document.querySelectorAll('.vuln-card').forEach((card) => {
    card.addEventListener('click', () => {
      const expanded = card.getAttribute('aria-expanded') === 'true';
      card.setAttribute('aria-expanded', String(!expanded));
    });
  });

  // IntersectionObserver for reveal elements inside the featured project
  const fpObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          fpObserver.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
  );

  document.querySelectorAll('.featured-project .reveal').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-visible');
    } else {
      fpObserver.observe(el);
    }
  });
</script>
