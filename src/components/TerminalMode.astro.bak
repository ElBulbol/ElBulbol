---
import { projects } from '../data/projects.js';
---

<div id="mode-terminal" class="mode-container" aria-hidden="true">
  <div class="terminal-island" data-terminal-root>
    <div class="terminal-header">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="title">foot &mdash; belal@portfolio: <span data-terminal-cwd>~</span></span>
    </div>
    <div class="terminal-body" data-terminal-output tabindex="-1"></div>
    <form class="terminal-input-row" data-terminal-form>
      <span class="prompt" data-terminal-prompt>[belal@portfolio ~]$</span>
      <input
        type="text"
        data-terminal-input
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Terminal command input"
      />
    </form>
  </div>
</div>

<style>
  #mode-terminal {
    display: none;
    opacity: 0;
    min-height: 100vh;
    padding: 2rem;
    transition: opacity 300ms ease;
  }

  #mode-terminal.is-visible {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: terminal-fade-in 300ms forwards;
  }

  @keyframes terminal-fade-in { to { opacity: 1; } }

  .terminal-island {
    width: 100%;
    max-width: 800px;
    background-color: var(--bg-panel-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .terminal-header {
    background-color: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .terminal-header .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-strong);
  }

  .terminal-header .title {
    margin-left: auto;
    margin-right: auto;
    font-size: var(--font-size-sm);
    color: var(--text-muted-2);
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-size: var(--font-size-sm);
    line-height: 1.7;
    color: var(--text-primary);
    max-height: 52vh;
    min-height: 220px;
    overflow-y: auto;
  }

  .term-out-line {
    white-space: pre-wrap;
    word-break: break-word;
    margin-bottom: 0.3rem;
  }

  .echo-prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .ls-dir { color: var(--term-blue); font-weight: 700; }
  .ls-file { color: var(--text-primary); }
  .term-error { color: var(--term-red); }

  .cat-output {
    color: var(--text-muted);
    font: inherit;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-top: 1px solid var(--border);
    padding: 0.75rem 1.25rem;
  }

  .terminal-input-row .prompt {
    color: var(--term-green);
    font-weight: 700;
    white-space: nowrap;
  }

  .terminal-input-row input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text-primary);
    font: inherit;
    font-size: var(--font-size-sm);
    caret-color: var(--accent);
  }
</style>

<script>
  import { terminalFS } from '../data/terminalFS.js';

  const projectLinks: Record<string, { github?: string; liveDemo?: string | null }> = {};

  type FSNode = { type: 'dir' | 'file' | 'secret'; children?: Record<string, FSNode>; content?: string };

  const root = document.querySelector('[data-terminal-root]');
  const output = document.querySelector('[data-terminal-output]') as HTMLElement | null;
  const form = document.querySelector('[data-terminal-form]') as HTMLFormElement | null;
  const input = document.querySelector('[data-terminal-input]') as HTMLInputElement | null;
  const promptEl = document.querySelector('[data-terminal-prompt]') as HTMLElement | null;
  const cwdEl = document.querySelector('[data-terminal-cwd]') as HTMLElement | null;

  if (root && output && form && input && promptEl && cwdEl) {
    let cwd: string[] = [];
    let history: string[] = [];
    let historyIndex = -1;
    let booted = false;
    const fs = terminalFS as FSNode;

    const pathLabel = () => (cwd.length ? `~/${cwd.join('/')}` : '~');

    const updatePrompt = () => {
      promptEl.textContent = `[belal@portfolio ${pathLabel()}]$`;
      cwdEl.textContent = pathLabel();
    };

    const getNode = (path: string[]): FSNode | null => {
      let node: FSNode = fs;
      for (const part of path) {
        if (node.type === 'file' || !node.children || !node.children[part]) return null;
        node = node.children[part];
      }
      return node;
    };

    const resolvePath = (raw: string): string[] => {
      const isAbsolute = raw.startsWith('/') || raw.startsWith('~');
      const base = isAbsolute ? [] : [...cwd];
      const cleaned = raw.replace(/^~\/?/, '').replace(/^\//, '');
      if (!cleaned) return base;
      cleaned.split('/').filter(Boolean).forEach((part) => {
        if (part === '.') return;
        if (part === '..') { base.pop(); return; }
        base.push(part);
      });
      return base;
    };

    const escapeHtml = (str: string) => str
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const printLine = (html: string, cls = '') => {
      const line = document.createElement('div');
      line.className = `term-out-line ${cls}`.trim();
      line.innerHTML = html;
      output.appendChild(line);
      output.scrollTop = output.scrollHeight;
    };

    const printEcho = (raw: string) => {
      printLine(`<span class="echo-prompt">${escapeHtml(promptEl.textContent || '')}</span> ${escapeHtml(raw)}`);
    };

    const isHidden = (name: string) => name.startsWith('.');

    const listing = (node: FSNode, showAll: boolean) => {
      const entries = Object.entries(node.children || {})
        .filter(([name]) => showAll || !isHidden(name))
        .map(([name, child]) => (
          child.type === 'file'
            ? `<span class="ls-file">${name}</span>`
            : `<span class="ls-dir">${name}/</span>`
        ));
      return entries.join('  ') || '(empty)';
    };

    const renderTree = (node: FSNode, prefix: string, showAll: boolean): string => {
      if (node.type === 'file' || !node.children) return '';
      const keys = Object.keys(node.children).filter((k) => showAll || !isHidden(k));
      return keys.map((key, i) => {
        const last = i === keys.length - 1;
        const child = node.children![key];
        const branch = `${prefix}${last ? '\u2514\u2500\u2500 ' : '\u251c\u2500\u2500 '}${child.type === 'file' ? key : key + '/'}`;
        const nested = child.type !== 'file'
          ? renderTree(child, `${prefix}${last ? '    ' : '\u2502   '}`, showAll)
          : '';
        return nested ? `${branch}\n${nested}` : branch;
      }).join('\n');
    };

    const HELP: [string, string][] = [
      ['help', 'show this list of commands'],
      ['ls [-a] [path]', 'list directory contents'],
      ['cd [path]', 'change directory'],
      ['cat <file>', 'print file contents'],
      ['pwd', 'print working directory'],
      ['whoami', 'about the person running this shell'],
      ['tree [-a]', 'show the filesystem tree'],
      ['history', 'show command history'],
      ['open <project-slug>', 'show a project\u2019s links'],
      ['contact', 'shortcut for cat contact.txt'],
      ['neofetch', 'system info banner'],
      ['clear', 'clear the terminal'],
      ['gui / exit / back', 'switch to the graphical portfolio'],
    ];

    const AUTOCOMPLETE_COMMANDS = ['help', 'ls', 'cd', 'cat', 'pwd', 'whoami', 'tree', 'history', 'open', 'contact', 'neofetch', 'clear', 'gui', 'exit'];

    const runCommand = (raw: string) => {
      const trimmed = raw.trim();
      if (!trimmed) return;
      printEcho(raw);
      history.push(raw);
      historyIndex = history.length;

      const parts = trimmed.split(/\s+/);
      const cmd = parts[0];
      const args = parts.slice(1);
      const flags = args.filter((a) => a.startsWith('-'));
      const positional = args.filter((a) => !a.startsWith('-'));
      const arg = positional.join(' ');

      switch (cmd) {
        case 'help':
          printLine(HELP.map(([c, d]) => `&nbsp;&nbsp;<span class="ls-file">${escapeHtml(c)}</span> &mdash; ${escapeHtml(d)}`).join('<br>'));
          break;

        case 'ls': {
          const showAll = flags.some((f) => f.includes('a'));
          const target = arg ? resolvePath(arg) : cwd;
          const node = getNode(target);
          if (!node) { printLine(`ls: cannot access '${escapeHtml(arg)}': No such file or directory`, 'term-error'); break; }
          if (node.type === 'file') { printLine(escapeHtml(arg || pathLabel())); break; }
          printLine(listing(node, showAll));
          break;
        }

        case 'cd': {
          if (!arg || arg === '~') { cwd = []; updatePrompt(); break; }
          const target = resolvePath(arg);
          const node = getNode(target);
          if (!node) { printLine(`cd: no such file or directory: ${escapeHtml(arg)}`, 'term-error'); break; }
          if (node.type === 'secret') {
            printLine('accessing restricted path\u2026 requesting confirmation.');
            document.dispatchEvent(new CustomEvent('personal-space-enter'));
            break;
          }
          if (node.type === 'file') { printLine(`cd: not a directory: ${escapeHtml(arg)}`, 'term-error'); break; }
          cwd = target;
          updatePrompt();
          break;
        }

        case 'cat': {
          if (!arg) { printLine('usage: cat &lt;file&gt;', 'term-error'); break; }
          const target = resolvePath(arg);
          const node = getNode(target);
          if (!node) { printLine(`cat: ${escapeHtml(arg)}: No such file or directory`, 'term-error'); break; }
          if (node.type === 'secret') { printLine(`this file requires interactive confirmation. try: <span class="ls-file">cd .config/belal_XD</span>`); break; }
          if (node.type === 'dir') { printLine(`cat: ${escapeHtml(arg)}: Is a directory`, 'term-error'); break; }
          printLine(`<pre class="cat-output">${escapeHtml(node.content || '')}</pre>`);
          break;
        }

        case 'pwd':
          printLine(pathLabel());
          break;

        case 'whoami':
          printLine('belal \u2014 SOC Analyst & Cybersecurity student. Run <span class="ls-file">cat about.txt</span> for more.');
          break;

        case 'tree': {
          const showAll = flags.some((f) => f.includes('a'));
          printLine(`<pre class="cat-output">~\n${escapeHtml(renderTree(fs, '', showAll))}</pre>`);
          break;
        }

        case 'history':
          printLine(history.map((h, i) => `${i + 1}  ${escapeHtml(h)}`).join('<br>') || '(empty)');
          break;

        case 'contact':
          runCommand('cat contact.txt');
          history.pop();
          break;

        case 'open': {
          if (!arg) { printLine('usage: open &lt;project-slug&gt;', 'term-error'); break; }
          const project = projects.find((p) => p.slug === arg);
          if (!project) { printLine(`open: unknown project '${escapeHtml(arg)}'. try 'ls projects'`, 'term-error'); break; }
          const links = [
            project.github ? `github: ${project.github}` : null,
            project.liveDemo ? `demo: ${project.liveDemo}` : null,
          ].filter(Boolean).join('\n') || 'no public links for this project yet.';
          printLine(`<pre class="cat-output">${escapeHtml(links)}</pre>`);
          break;
        }

        case 'neofetch':
          printLine(`<pre class="cat-output">belal@portfolio
-----------------
OS: Arch Linux
WM: sway
Bar: waybar
Terminal: foot
Shell: portfolio-sh
Role: SOC Analyst &amp; Cybersecurity Student</pre>`);
          break;

        case 'sudo':
          printLine('belal is not in the sudoers file. This incident will be reported.', 'term-error');
          break;

        case 'clear':
          output.innerHTML = '';
          break;

        case 'gui':
        case 'exit':
        case 'back':
        case 'logout':
          printLine('switching to graphical mode\u2026');
          window.setTimeout(() => {
            sessionStorage.setItem('portfolio-mode', 'graphical');
            document.dispatchEvent(new CustomEvent('mode-selected', { detail: { mode: 'graphical' } }));
          }, 200);
          break;

        default:
          printLine(`command not found: ${escapeHtml(cmd)} (try 'help')`, 'term-error');
      }
    };

    const completeInput = () => {
      const val = input.value;
      const parts = val.split(' ');
      const last = parts[parts.length - 1];
      if (parts.length === 1) {
        const matches = AUTOCOMPLETE_COMMANDS.filter((c) => c.startsWith(last));
        if (matches.length === 1) { parts[0] = matches[0]; input.value = `${parts.join(' ')} `; }
        else if (matches.length > 1) printLine(matches.join('  '));
        return;
      }
      const node = getNode(cwd);
      if (node && node.children) {
        const matches = Object.keys(node.children).filter((name) => name.startsWith(last) && !isHidden(name));
        if (matches.length === 1) { parts[parts.length - 1] = matches[0]; input.value = parts.join(' '); }
        else if (matches.length > 1) printLine(matches.join('  '));
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value;
      input.value = '';
      runCommand(value);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (historyIndex > 0) { historyIndex -= 1; input.value = history[historyIndex] || ''; }
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (historyIndex < history.length - 1) { historyIndex += 1; input.value = history[historyIndex]; }
        else { historyIndex = history.length; input.value = ''; }
      } else if (event.key === 'Tab') {
        event.preventDefault();
        completeInput();
      }
    });

    root.addEventListener('click', () => input.focus());
    updatePrompt();

    document.addEventListener('mode-selected', (event) => {
      const mode = (event as CustomEvent<{ mode: string }>).detail.mode;
      if (mode === 'terminal') {
        if (!booted) {
          booted = true;
          printLine('Welcome to <span class="ls-file">belal@portfolio</span>. Type <span class="ls-file">help</span> to get started.');
        }
        window.setTimeout(() => input.focus(), 50);
      }
    });
  }
</script>
