---
const { project } = Astro.props;
---

<article class="project-card reveal">
  <div class="header">
    <div class="title-row">
      <h3 class="title">{project.title}</h3>
      {project.date && <span class="date">{project.date}</span>}
    </div>
    {project.role && <div class="role">{project.role}</div>}
    {project.category && <span class="category-badge">{project.category}</span>}
  </div>

  <p class="description">{project.shortDescription}</p>

  {project.certification && (
    <div class="certification">
      ↳ Part of {project.certification.name} — {project.certification.issuer}
    </div>
  )}

  {project.tech && project.tech.length > 0 && (
    <div class="tech-tags">
      {project.tech.map((tag: string) => (
        <span class="tech-tag">{tag}</span>
      ))}
    </div>
  )}

  <div class="links">
    {project.github && (
      <a href={project.github} class="link" target="_blank" rel="noopener noreferrer">[↗ GitHub]</a>
    )}
    {project.liveDemo && (
      <a href={project.liveDemo} class="link" target="_blank" rel="noopener noreferrer">[↗ Live Demo]</a>
    )}
  </div>
</article>

<style>
  .project-card {
    background-color: var(--bg-panel-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-structural);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 1rem;
  }

  .title {
    color: var(--text-primary);
    font-size: var(--font-size-xl);
    margin: 0;
  }

  .date {
    color: var(--text-muted-2);
    font-size: var(--font-size-sm);
    white-space: nowrap;
    margin-top: 0.25rem;
  }

  .role {
    color: var(--text-muted-2);
    font-size: var(--font-size-sm);
  }

  .category-badge {
    display: inline-block;
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 9999px;
    padding: 0.125rem 0.5rem;
    margin-top: 0.25rem;
  }

  .description {
    color: var(--text-muted);
    font-size: var(--font-size-base);
    margin: 0;
    line-height: 1.5;
  }

  .certification {
    color: var(--text-muted-2);
    font-size: var(--font-size-sm);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background-color: var(--bg-base);
    border: 1px solid var(--border);
    color: var(--text-muted-2);
    font-size: var(--font-size-sm);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .link {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono, monospace);
    transition: color 0.2s ease;
  }

  .link:hover {
    color: var(--text-primary);
  }
</style>
