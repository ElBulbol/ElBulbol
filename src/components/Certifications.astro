---
import { certifications } from '../data/certifications.js';

const hasPendingUrl = (url?: string) => !url || url.startsWith('REPLACE_WITH_');
const issuerGlyphs: Record<string, string> = {
  'TryHackMe': 'THM',
  'Netriders Academy': 'NRA',
  'Cisco (via Credly)': 'CIS',
  'NTI': 'NTI',
};
---

<section id="certifications" class="certifications-section">
  <div class="certifications-heading">
    <span class="terminal-prompt">[belal@portfolio ~]$</span><h2 class="heading-text">ls certifications</h2>
  </div>

  <div class="certifications-container">
    <div class="certifications-overview">
      <p class="certifications-intro">Training records, verified credentials, and active learning paths.</p>
      <span class="credential-stat"><b data-credential-count>5</b> credentials tracked <i>·</i> <b>1</b> in progress</span>
    </div>

    <div class="certification-list" data-certification-list>
      {certifications.map((cert, index) => {
        const inProgress = cert.status === 'in_progress';
        const pendingUrl = hasPendingUrl(cert.verifyUrl);
        const glyph = issuerGlyphs[cert.issuer] || 'CERT';
        return (
          <details class:list={['certification-record', { 'is-in-progress': inProgress }]} data-certification-record={index} open={index === 0}>
            <summary>
              <span class="record-index">{String(index + 1).padStart(2, '0')}</span>
              <span class:list={['issuer-badge', { 'is-active': inProgress }]} aria-label={`${cert.issuer} badge`}>
                <svg viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                  <path d="M18 3 31 10.5v15L18 33 5 25.5v-15Z" />
                  <text x="18" y="20.5" text-anchor="middle">{glyph}</text>
                </svg>
              </span>
              <span class="record-title"><strong>{cert.title}</strong><small>{cert.issuer}</small></span>
              <span class:list={['record-status', { 'is-active': inProgress }]}>
                <i aria-hidden="true"></i><span data-status-copy>{inProgress ? 'IN PROGRESS' : 'VERIFIED ✓'}</span>
              </span>
              <span class="record-date">{inProgress ? `expected ${cert.expected}` : cert.date}</span>
              <span class="record-toggle" aria-hidden="true">+</span>
            </summary>

            <div class="certificate-detail">
              <div>
                <span class="detail-label">{inProgress ? 'CURRENT TRAINING' : 'ISSUED'}</span>
                <p>{inProgress ? cert.note : `${cert.issuer} · ${cert.date}`}</p>
                {cert.context && <p class="certificate-context">{cert.context}</p>}
              </div>
              <div class="certificate-actions">
                {cert.credentialId && <code>credential ID: {cert.credentialId}</code>}
                {inProgress ? (
                  <span class="progress-cursor">training in progress<span aria-hidden="true">_</span></span>
                ) : pendingUrl ? (
                  <span class="pending-link">[ verification URL pending ]</span>
                ) : (
                  <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="verify-link">[↗ View Certificate]</a>
                )}
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
  .certifications-section { align-items:center; background:var(--bg-base); display:flex; flex-direction:column; gap:2rem; padding:6rem 2rem 8rem; }
  .certifications-heading { align-items:baseline; border-bottom:1px solid var(--border); display:flex; gap:.7rem; max-width:1320px; padding-bottom:1.75rem; width:100%; }
  .terminal-prompt { color:var(--accent); font-family:var(--font-mono); font-size:clamp(.85rem,1.5vw,1.15rem); font-weight:700; white-space:nowrap; }
  .heading-text { color:var(--text-primary); font-family:var(--font-mono); font-size:clamp(1.65rem,3.4vw,3rem); font-weight:700; margin:0; }
  .certifications-container { display:flex; flex-direction:column; gap:1.5rem; max-width:1320px; width:100%; }
  .certifications-overview { align-items:baseline; display:flex; flex-wrap:wrap; gap:.7rem 1.25rem; justify-content:space-between; }
  .certifications-intro { color:var(--text-muted); font-size:clamp(1rem,1.35vw,1.2rem); line-height:1.8; margin:0; }
  .credential-stat { color:var(--text-muted-2); font-size:10px; letter-spacing:.04em; white-space:nowrap; }.credential-stat b { color:var(--accent); font-weight:500; }.credential-stat i { color:var(--border-strong); font-style:normal; margin:0 .25rem; }
  .certification-list { border-top:1px solid var(--border); }
  .certification-record { background:var(--bg-panel-solid); border:1px solid var(--border); border-top:0; overflow:hidden; position:relative; transform:translateY(0); transition:border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
  .certification-list.is-observing .certification-record { opacity:0; transform:translateY(12px); }.certification-list.is-observing .certification-record.is-revealed { opacity:1; transform:translateY(0); transition-delay:var(--row-delay); }
  .certification-record::before { background:linear-gradient(90deg,transparent,rgba(122,162,247,.12),transparent); content:''; height:100%; left:-45%; pointer-events:none; position:absolute; top:0; transform:skewX(-18deg); width:30%; z-index:1; }
  .certification-record:hover, .certification-record:focus-within { border-color:var(--accent); box-shadow:0 8px 22px rgba(0,0,0,.18),inset 2px 0 0 var(--accent); transform:translateY(-2px); z-index:2; }
  .certification-record:hover::before, .certification-record:focus-within::before { animation:scan-row 550ms ease-out; }
  .certification-record.is-in-progress { border-left-color:var(--accent); border-right-color:var(--accent); border-style:dashed; }.certification-record.is-in-progress::after { animation:progress-sweep 2.4s linear infinite; background:linear-gradient(90deg,transparent,var(--accent),transparent); bottom:0; content:''; height:2px; left:0; position:absolute; width:42%; z-index:2; }
  .certification-record summary { align-items:center; cursor:pointer; display:grid; gap:1rem; grid-template-columns:30px 38px minmax(0,1fr) auto 104px 20px; list-style:none; padding:1rem 1.2rem; position:relative; z-index:2; }.certification-record summary::-webkit-details-marker { display:none; }.certification-record summary:focus-visible { box-shadow:inset 0 0 0 1px var(--accent); outline:none; }
  .record-index { color:var(--accent); font-size:11px; }.issuer-badge { display:block; filter:drop-shadow(0 0 5px rgba(122,162,247,.18)); height:30px; width:30px; }.issuer-badge svg { display:block; height:100%; width:100%; }.issuer-badge path { fill:rgba(122,162,247,.06); stroke:var(--accent); stroke-width:1.25; }.issuer-badge text { fill:var(--text-primary); font-family:var(--font-mono); font-size:7px; font-weight:600; }.issuer-badge.is-active { animation:badge-pulse 2s ease-in-out infinite; }.issuer-badge.is-active path { stroke:var(--term-cyan); }
  .record-title { display:grid; gap:.25rem; min-width:0; }.record-title strong { color:var(--text-primary); font-size:var(--font-size-sm); font-weight:600; line-height:1.55; }.record-title small, .record-date { color:var(--text-muted-2); font-size:10px; }
  .record-status { align-items:center; color:var(--term-green); display:flex; font-size:10px; gap:.4rem; letter-spacing:.04em; white-space:nowrap; }.record-status i { background:var(--term-green); border-radius:50%; height:5px; width:5px; }.record-status.is-active { color:var(--accent); }.record-status.is-active i { animation:active-pulse 1.6s ease-in-out infinite; background:var(--accent); }
  .record-date { text-align:right; white-space:nowrap; }.record-toggle { color:var(--accent); font-size:18px; line-height:1; text-align:center; transition:transform 180ms ease; }details[open] .record-toggle { transform:rotate(45deg); }
  .certificate-detail { border-top:1px solid var(--border); display:grid; gap:1rem; grid-template-columns:minmax(0,1fr) auto; overflow:hidden; padding:1rem 1.2rem 1.2rem 5.4rem; position:relative; z-index:2; }.detail-label { color:var(--text-muted-2); display:block; font-size:10px; letter-spacing:.05em; }.certificate-detail p { color:var(--text-muted); font-size:var(--font-size-sm); line-height:1.75; margin:.45rem 0 0; max-width:760px; }.certificate-detail .certificate-context { color:var(--text-muted-2); font-size:11px; }
  .certificate-actions { align-items:flex-end; display:flex; flex-direction:column; gap:.7rem; justify-content:center; }.certificate-actions code { color:var(--text-muted-2); font-family:inherit; font-size:10px; white-space:nowrap; }.verify-link, .pending-link, .progress-cursor { font-size:11px; white-space:nowrap; }.verify-link { color:var(--accent); text-decoration:none; }.verify-link:hover, .verify-link:focus-visible { color:var(--text-primary); outline:none; }.pending-link { color:var(--text-muted-2); }.progress-cursor { color:var(--accent); }.progress-cursor span { animation:cursor-blink 1s steps(1,end) infinite; }
  @keyframes scan-row { to { left:125%; } }@keyframes progress-sweep { from { transform:translateX(-110%); } to { transform:translateX(340%); } }@keyframes badge-pulse { 50% { filter:drop-shadow(0 0 9px rgba(125,207,255,.65)); transform:scale(1.04); } }@keyframes active-pulse { 50% { box-shadow:0 0 0 4px rgba(122,162,247,0); opacity:.45; } }@keyframes cursor-blink { 50% { opacity:0; } }
  @media (max-width:700px) { .certifications-section { padding:5rem 1rem 6rem; }.certifications-heading { align-items:flex-start; flex-wrap:wrap; gap:.35rem .55rem; }.terminal-prompt { font-size:.78rem; padding-top:.35rem; }.heading-text { font-size:clamp(1.35rem,7vw,1.8rem); }.certification-record summary { align-items:start; grid-template-columns:30px 34px minmax(0,1fr) 20px; gap:.7rem; }.issuer-badge { height:28px; width:28px; }.record-status { grid-column:3; }.record-date { grid-column:3; grid-row:3; text-align:left; }.record-toggle { grid-column:4; grid-row:1; }.certificate-detail { grid-template-columns:1fr; padding:1rem; }.certificate-actions { align-items:flex-start; } }
  @media (prefers-reduced-motion:reduce) { .certification-list.is-observing .certification-record { opacity:1; transform:none; }.issuer-badge.is-active, .record-status.is-active i, .progress-cursor span, .certification-record.is-in-progress::after { animation:none; }.certification-record:hover, .certification-record:focus-within { transform:none; }.certification-record:hover::before, .certification-record:focus-within::before { animation:none; } }
</style>

<script>
  const certificationSection = document.querySelector('#certifications');
  if (certificationSection) {
    const list = certificationSection.querySelector('[data-certification-list]');
    const records = [...certificationSection.querySelectorAll('[data-certification-record]')] as HTMLDetailsElement[];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const statusTimers = new Map<HTMLElement, number[]>();

    const resetStatus = (record: HTMLDetailsElement) => {
      const status = record.querySelector('[data-status-copy]') as HTMLElement | null;
      if (!status || record.classList.contains('is-in-progress')) return;
      (statusTimers.get(status) || []).forEach(window.clearTimeout);
      statusTimers.delete(status);
      status.textContent = 'VERIFIED ✓';
    };

    const verifyStatus = (record: HTMLDetailsElement) => {
      const status = record.querySelector('[data-status-copy]') as HTMLElement | null;
      if (!status || record.classList.contains('is-in-progress') || reduceMotion) return;
      resetStatus(record);
      status.textContent = 'checking...';
      const connecting = window.setTimeout(() => { status.textContent = 'verifying issuer...'; }, 210);
      const verified = window.setTimeout(() => { status.textContent = 'VERIFIED ✓'; }, 680);
      statusTimers.set(status, [connecting, verified]);
    };

    const animateDisclosure = (record: HTMLDetailsElement) => {
      const summary = record.querySelector('summary');
      const detail = record.querySelector('.certificate-detail') as HTMLElement | null;
      if (!summary || !detail || reduceMotion) return;
      summary.addEventListener('click', (event) => {
        event.preventDefault();
        detail.getAnimations().forEach((animation) => animation.cancel());
        if (!record.open) {
          record.open = true;
          const targetHeight = detail.offsetHeight;
          detail.style.height = '0px';
          detail.style.opacity = '0';
          requestAnimationFrame(() => {
            const animation = detail.animate([{ height: '0px', opacity: 0 }, { height: `${targetHeight}px`, opacity: 1 }], { duration: 180, easing: 'ease-out' });
            animation.onfinish = () => { detail.style.height = ''; detail.style.opacity = ''; };
          });
        } else {
          const startHeight = detail.offsetHeight;
          const animation = detail.animate([{ height: `${startHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }], { duration: 160, easing: 'ease-in' });
          animation.onfinish = () => { record.open = false; };
        }
      });
    };

    records.forEach((record, index) => {
      record.style.setProperty('--row-delay', `${index * 70}ms`);
      animateDisclosure(record);
    });

    if (!reduceMotion && list) {
      list.classList.add('is-observing');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const record = entry.target as HTMLDetailsElement;
          if (entry.isIntersecting) {
            record.classList.add('is-revealed');
            verifyStatus(record);
          } else {
            record.classList.remove('is-revealed');
            resetStatus(record);
          }
        });
      }, { threshold: 0.2 });
      records.forEach((record) => observer.observe(record));
    }
  }
</script>
