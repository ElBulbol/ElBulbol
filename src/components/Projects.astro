---
import { projects, categories } from '../data/projects.js';
import ProjectFeatured from './ProjectFeatured.astro';
import ProjectFeaturedInfra from './ProjectFeaturedInfra.astro';
import ProjectCard from './ProjectCard.astro';

const layoutComponents: Record<string, any> = {
  'infrastructure': ProjectFeaturedInfra,
  'attack-defend': ProjectFeatured,
  'default': ProjectCard
};

// Sort projects (featured first, or just separate them)
const featuredProjects = projects.filter(p => p.featured);
const normalProjects = projects.filter(p => !p.featured);
---

<section id="projects" class="projects-section">
  <!-- Section heading -->
  <div class="projects-heading reveal">
    <span class="heading-prefix">~/</span><h2 class="heading-text">projects</h2>
  </div>

  <div class="projects-container">
    
    <!-- Filter Bar -->
    <div class="filter-bar reveal delay-1">
      {categories.map((cat) => (
        <button class={`filter-btn ${cat === 'all' ? 'is-active' : ''}`} data-filter={cat}>
          {cat.toUpperCase()}
        </button>
      ))}
    </div>

    <!-- Featured Projects -->
    <div class="projects-list featured-list">
      {featuredProjects.map((project) => {
        const Component = layoutComponents[project.layout] || layoutComponents['default'];
        return (
          <div class="project-wrapper" data-category={project.category}>
            <Component project={project} />
          </div>
        );
      })}
    </div>

    <!-- Normal Projects Grid -->
    <div class="projects-grid normal-list">
      {normalProjects.map((project) => (
        <div class="project-wrapper" data-category={project.category}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
    
    <!-- Empty state -->
    <div class="empty-state" style="display: none;">
      <p class="empty-text">No projects found in this category.</p>
    </div>

  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 2rem 8rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--bg-base);
    gap: 2rem;
  }

  /* Section heading */
  .projects-heading {
    display: flex;
    align-items: baseline;
    gap: 0;
    width: 100%;
    max-width: 1200px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .heading-prefix {
    color: var(--accent);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .heading-text {
    color: var(--text-primary);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    font-family: var(--font-mono);
    margin: 0;
  }

  .projects-container {
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Filter Bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .filter-btn.is-active {
    background: var(--bg-panel-solid);
    border-color: var(--accent);
    color: var(--text-primary);
  }

  /* Lists */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .project-wrapper {
    display: block;
  }
  
  .project-wrapper.is-hidden {
    display: none;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 4rem 0;
  }

  .empty-text {
    color: var(--text-muted-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-1 { transition-delay: 150ms; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Simple filtering logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectWrappers = document.querySelectorAll('.project-wrapper');
  const emptyState = document.querySelector('.empty-state') as HTMLElement;

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      filterBtns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const filter = btn.getAttribute('data-filter');
      let visibleCount = 0;

      // Filter projects
      projectWrappers.forEach(wrapper => {
        const cat = wrapper.getAttribute('data-category');
        if (filter === 'all' || filter === cat) {
          wrapper.classList.remove('is-hidden');
          visibleCount++;
        } else {
          wrapper.classList.add('is-hidden');
        }
      });

      // Show/hide empty state
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });

  // IntersectionObserver for reveal elements
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });

  document.querySelectorAll('.projects-section .reveal').forEach(el => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.classList.add('is-visible');
    } else {
      observer.observe(el);
    }
  });
</script>
