---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import BootScreen from '../components/BootScreen.astro';
import ModeGate from '../components/ModeGate.astro';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Belal Alshref — SOC Analyst & Cybersecurity',
  description = 'Cybersecurity portfolio of Belal Alshref — SOC Analyst and threat hunter.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <BootScreen />
    <ModeGate />
    <CustomCursor />
    <main id="site-content">
      <slot />
    </main>
  </body>
</html>
